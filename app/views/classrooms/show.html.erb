<%# --- SISTEMA DE NOTIFICAÇÃO (TOAST) --- %>
<% if notice || alert %>
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="liveToast" class="toast show align-items-center text-white <%= notice ? 'bg-success' : 'bg-danger' %> border-0 rounded-4 shadow-lg" role="alert">
      <div class="d-flex">
        <div class="toast-body fw-bold">
          <i class="bi <%= notice ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %> me-2"></i>
          <%= notice || alert %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>
<% end %>

<%# --- FORMULÁRIO DE TRANSFERÊNCIA (INVISÍVEL) --- %>
<%= form_with url: transfer_students_classroom_path(@classroom), method: :post, id: "transfer_students_form", data: { turbo: false } do |f| %>
<% end %>

<div class="row justify-content-center pb-5 text-dark">
  <div class="col-lg-12">
    
    <%# --- CABEÇALHO --- %>
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div class="d-flex align-items-center">
        <%= link_to classrooms_path, class: "btn btn-light rounded-circle me-3 shadow-sm" do %>
          <i class="bi bi-arrow-left"></i>
        <% end %>
        <div>
          <h2 class="fw-bold text-dark mb-0"><%= @classroom&.display_name %></h2>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
            <%= @classroom&.course&.name %>
          </span>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= link_to activities_path(filter_course: @classroom&.course_id, filter_grade: @classroom&.grade_id), class: "btn btn-dark rounded-pill px-4 shadow-sm fw-bold" do %>
          <i class="bi bi-graph-up-arrow me-2"></i>Painel de Desempenho
        <% end %>
        <%= link_to grading_classroom_path(@classroom), class: "btn btn-primary rounded-pill px-4 shadow-sm fw-bold" do %>
          <i class="bi bi-pencil-square me-2"></i>Boletim Rápido
        <% end %>
      </div>
    </div>

    <%# --- CARDS DE RESUMO --- %>
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-body p-4">
        <div class="row text-center g-3">
          <div class="col-md-3 border-end border-light">
            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Série</small>
            <span class="fs-6 fw-bold text-dark"><%= @classroom&.grade&.name %></span>
          </div>
          <div class="col-md-3 border-end border-light">
            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Seção</small>
            <span class="fs-6 fw-bold text-dark"><%= @classroom&.section&.name %></span>
          </div>
          <div class="col-md-3 border-end border-light">
            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Alunos</small>
            <span class="fs-6 fw-bold text-primary"><%= @classroom&.students&.count %></span>
          </div>
          <div class="col-md-3">
            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Total de Aulas</small>
            <span class="fs-6 fw-bold text-success"><%= @classroom&.lessons&.count %></span>
          </div>
        </div>
      </div>
    </div>

    <%# --- QUADRO DE GESTÃO E TABELA DE ALUNOS --- %>
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
      <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-people-fill me-2"></i>Quadro de Entregas e Gestão</h6>
        <div class="d-flex gap-2">
          <%= select_tag :target_classroom_id, 
              options_from_collection_for_select(Classroom.where.not(id: @classroom&.id), :id, :display_name), 
              include_blank: "Transferir para...", 
              class: "form-select form-select-sm shadow-sm", style: "width: 220px;", required: true,
              form: "transfer_students_form" %>
          
          <button type="submit" form="transfer_students_form" class="btn btn-warning btn-sm px-3 shadow-sm fw-bold" onclick="return confirm('Deseja transferir os alunos selecionados?')">
            Transferir Selecionados
          </button>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr class="text-uppercase text-muted" style="font-size: 0.65rem;">
                <th class="text-center" style="width: 50px;">
                  <input type="checkbox" id="selectAll" class="form-check-input">
                </th>
                <th class="ps-4">Nome do Aluno</th>
                <th class="text-center">Desempenho</th>
                
                <%# Cabeçalho Dinâmico de Atividades %>
                <% lesson_ids = @classroom.lessons.pluck(:id) %>
                <% current_activities = Activity.where(lesson_id: lesson_ids).order(date: :asc).limit(5) %>
                <% if current_activities.any? %>
                  <% current_activities.each do |activity| %>
                    <th class="text-center border-start p-2" title="<%= activity.name %>" data-bs-toggle="tooltip">
                      <div class="vertical-header text-uppercase" style="font-size: 0.55rem;"><%= activity.name.truncate(10) %></div>
                    </th>
                  <% end %>
                <% end %>
                <th class="text-end pe-4">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% if @classroom.students.any? %>
                <% @classroom.students.each do |student| %>
                  <tr class="grading-row">
                    <td class="text-center">
                      <%= check_box_tag "student_ids[]", student.id, false, class: "form-check-input student-checkbox", form: "transfer_students_form" %>
                    </td>
                    <td class="ps-4">
                      <span class="small fw-bold text-dark"><%= student.name.upcase %></span>
                    </td>
                    <td class="px-3" style="width: 150px;">
                      <div class="d-flex align-items-center">
                        <div class="progress flex-grow-1" style="height: 6px; background-color: #f0f0f0;">
                          <% freq = student.respond_to?(:activity_performance) ? student.activity_performance : 0 %>
                          <div class="progress-bar <%= freq < 60 ? 'bg-danger' : 'bg-success' %>" style="width: <%= freq %>%"></div>
                        </div>
                        <span class="ms-2 fw-bold text-muted" style="font-size: 0.65rem;"><%= freq %>%</span>
                      </div>
                    </td>

                    <% if current_activities.any? %>
                      <% current_activities.each do |activity| %>
                        <td class="text-center border-start">
                          <% submission = student.student_activities.find_by(activity_id: activity.id) %>
                          <% if submission&.status == "Entregue" %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% elsif submission&.status == "Não Entregue" %>
                            <i class="bi bi-x-circle-fill text-danger"></i>
                          <% else %>
                            <i class="bi bi-clock text-warning"></i>
                          <% end %>
                        </td>
                      <% end %>
                    <% end %>

                    <td class="text-end pe-4">
                      <div class="d-flex justify-content-end gap-1">
                        <%= link_to student_path(student), class: "btn btn-sm btn-light border shadow-sm", title: "Ver Ficha", data: { bs_toggle: "tooltip" } do %>
                          <i class="bi bi-graph-up text-primary"></i>
                        <% end %>
                        <%= button_to student_path(student), method: :delete, data: { turbo_confirm: "Atenção: Isso apagará os registros deste aluno. Deseja continuar?", bs_toggle: "tooltip" }, class: "btn btn-sm btn-light border shadow-sm text-danger", title: "Excluir" do %>
                          <i class="bi bi-trash"></i>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr><td colspan="10" class="text-center py-4 text-muted">Nenhum aluno nesta turma.</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%# --- PLANEJAMENTO DE AULAS --- %>
    <div class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-book me-2 text-primary"></i>Planejamento de Aulas</h5>
        <%= link_to lessons_path, class: "btn btn-outline-primary btn-sm rounded-pill px-3" do %>Ver Todo Planejamento<% end %>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr class="text-uppercase text-muted" style="font-size: 0.65rem;">
              <th class="ps-4 py-3">Data</th>
              <th>Tópico / Conteúdo</th>
              <th>Status do Vínculo</th>
              <th class="text-end pe-4">Ação</th>
            </tr>
          </thead>
          <tbody>
            <% if @classroom&.lessons&.any? %>
              <% @classroom.lessons.order(date: :desc).limit(10).each do |lesson| %>
                <tr>
                  <td class="ps-4 fw-bold text-secondary small"><%= lesson.date&.strftime("%d/%m/%Y") %></td>
                  <td><span class="fw-bold text-dark small"><%= lesson.topic_name %></span></td>
                  <td>
                    <%# Lógica de Vínculo com Atividade %>
                    <% activity = Activity.find_by(lesson_id: lesson.id) %>
                    
                    <% if activity.present? %>
                      <div class="d-flex align-items-center gap-2">
                        <% if activity.status == "corrigida" %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle px-2" style="font-size: 0.6rem;">
                            <i class="bi bi-check-circle-fill me-1"></i>CORRIGIDA
                          </span>
                        <% else %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2" style="font-size: 0.6rem;">
                            <i class="bi bi-link-45deg me-1"></i>VINCULADA
                          </span>
                          
                          <%# ALTERAÇÃO AQUI: Trocamos link_to por button_to para garantir o método PATCH %>
                          <%= button_to mark_as_corrected_activity_path(activity), 
                                      method: :patch,
                                      data: { turbo_confirm: "Marcar como corrigida?" }, 
                                      class: "btn btn-sm btn-outline-success border-0 p-0 px-1 text-success bg-transparent",
                                      title: "Concluir Correção" do %>
                            <i class="bi bi-check2-all fs-5 fw-bold"></i>
                          <% end %>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2" style="font-size: 0.6rem;">
                        <i class="bi bi-exclamation-circle me-1"></i>PENDENTE
                      </span>
                    <% end %>
                  </td>
                  <td class="text-end pe-4">
                    <%= link_to edit_lesson_path(lesson), class: "btn btn-sm btn-light border shadow-sm" do %>
                      <i class="bi bi-pencil text-primary"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="4" class="text-center py-4 text-muted small">Nenhum aula registrada.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# --- AÇÕES DA TURMA --- %>
    <div class="d-flex justify-content-between">
      <%= link_to edit_classroom_path(@classroom), class: "btn btn-light border rounded-pill px-4 fw-bold" do %>
        <i class="bi bi-gear me-2"></i>Editar Turma
      <% end %>
      <%= button_to @classroom, method: :delete, data: { turbo_confirm: "Excluir TURMA permanentemente?" }, class: "btn btn-link text-danger text-decoration-none" do %>
        <i class="bi bi-trash me-1"></i> Excluir Turma
      <% end %>
    </div>

  </div>
</div>

<%# --- SCRIPTS --- %>
<script>
  document.addEventListener("turbo:load", function() {
    // Lógica de Selecionar Todos os Checkboxes
    const selectAll = document.getElementById('selectAll');
    if (selectAll) {
      selectAll.addEventListener('change', function() {
        document.querySelectorAll('.student-checkbox').forEach(cb => { 
          cb.checked = selectAll.checked; 
        });
      });
    }

    // Inicialização de Tooltips do Bootstrap
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    if (typeof bootstrap !== 'undefined') {
      [...tooltipTriggerList].map(el => new bootstrap.Tooltip(el));
    }
  });
</script>

<%# --- ESTILOS ADICIONAIS --- %>
<style>
  .vertical-header { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; display: inline-block; color: #6c757d; }
  .bg-success-subtle { background-color: #d1e7dd !important; color: #0f5132 !important; }
  .bg-primary-subtle { background-color: #cfe2ff !important; color: #084298 !important; }
  .bg-warning-subtle { background-color: #fff3cd !important; color: #664d03 !important; }
  .grading-row:hover { background-color: #f8f9fa; }
  
  /* Reset para o botão de correção não parecer um botão de formulário pesado */
  form.button_to { display: inline; }
</style>