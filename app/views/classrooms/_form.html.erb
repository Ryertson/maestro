<%= form_with(model: classroom, class: "contents") do |form| %>
  <% if classroom.errors.any? %>
    <div id="error_explanation" class="alert alert-danger shadow-sm rounded-4">
      <h6 class="fw-bold"><%= pluralize(classroom.errors.count, "erro") %> impediram o salvamento:</h6>
      <ul class="mb-0 small">
        <% classroom.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# --- CAMPO NOME --- %>
  <div class="mb-4">
    <%= form.label :name, "Nome da Turma", class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control form-control-lg shadow-sm border-2", placeholder: "Ex: 3º Ano A - Matutino" %>
  </div>

  <div class="row">
    <%# --- SELEÇÃO DE CURSO --- %>
    <div class="col-md-6 mb-3">
      <%= form.label :course_id, "Curso", class: "form-label fw-bold" %>
      <%= form.collection_select :course_id, Course.all.order(:name), :id, :name, { prompt: "Selecione o curso" }, { class: "form-select shadow-sm" } %>
    </div>

    <%# --- SELEÇÃO DE SÉRIE --- %>
    <div class="col-md-6 mb-3">
      <%= form.label :level_id, "SÉRIE / ANO", class: "form-label fw-bold" %>
      <div class="input-group">
        <span class="input-group-text bg-light border-0"><i class='bx bx-layer'></i></span>
        <%# Forçamos a busca direta para garantir que as 3 séries apareçam %>
        <%= form.collection_select :level_id, Level.all, :id, :id, { prompt: "Teste de ID" }, { class: "form-select" } %>
      </div>
    </div>
  </div> <%# AQUI ESTAVA O ERRO: Faltava fechar a div row %>

  <hr class="my-4 opacity-25">

  <%# --- CAMPO DO PROFESSOR --- %>
  <div class="mb-4 p-3 bg-light rounded-4 border">
    <label class="form-label fw-bold text-primary">
      <i class="bi bi-person-badge-fill me-2"></i>Professor Responsável
    </label>
    
    <%= form.collection_select :teacher_id, Teacher.all.order(:name), :id, :name, 
        { include_blank: "Deixar sem professor por enquanto" }, 
        { class: "form-select form-select-lg shadow-sm border-primary" } %>
  </div>

  <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
    <%= link_to "Cancelar", classrooms_path, class: "btn btn-light rounded-pill px-4" %>
    <%= form.submit "Salvar Turma Agora", class: "btn btn-primary rounded-pill px-5 shadow" %>
  </div>
<% end %>