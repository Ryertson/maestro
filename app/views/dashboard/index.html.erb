<div class="teacher-dashboard-neon min-vh-100 py-4">
  <div class="container-fluid px-4">
    
    <%# --- TOPO: SELEÇÃO E FILTROS --- %>
    <div class="content-card-purple mb-4 p-3 shadow-lg">
      <%= form_with url: root_path, method: :get, local: true, class: "row g-3 align-items-center" do |f| %>
        <div class="col-md-3">
          <h1 class="h4 fw-bold text-purple-neon mb-0">
            <i class="bx bxs-zap me-2"></i>Maestro IA
          </h1>
          <small class="text-white opacity-75">Análise de Desempenho em Tempo Real</small>
        </div>

        <div class="col-md-2">
          <label class="label-neon-small text-lavender">1. Filtrar Turma</label>
          <%= f.select :classroom_id, options_from_collection_for_select(@classrooms, :id, :full_name_info, params[:classroom_id]), { prompt: "Selecionar Turma" }, { class: "form-select-neon text-white", onchange: "this.form.submit()" } %>
        </div>

        <div class="col-md-2">
          <label class="label-neon-small text-lavender">2. Disciplina</label>
          <%= f.select :subject_id, options_from_collection_for_select(@subjects_in_classroom || [], :id, :name, params[:subject_id]), { prompt: "Selecione a Matéria" }, { class: "form-select-neon text-white", onchange: "this.form.submit()" } %>
        </div>

        <div class="col-md-3">
          <label class="label-neon-small text-lavender">3. Selecionar Aluno</label>
          <%= f.select :student_id, options_from_collection_for_select(@students || [], :id, :name, params[:student_id]), { prompt: "Selecione o Aluno" }, { class: "form-select-neon text-white", onchange: "this.form.submit()" } %>
        </div>

        <div class="col-md-2 text-end pt-3">
          <span class="badge-neon-purple px-3 py-2" title="<%= current_professor.email %>">
            <i class="bx bxs-user-circle me-1"></i>
            <%= current_view_mode == :modo_admin ? "Administrador" : (@teacher&.name&.split(' ')&.first || "Docente") %>
          </span>
        </div>
      <% end %>
    </div>

    <% if @student.nil? %>
      <div class="text-center py-5">
        <div class="display-1 text-purple-neon opacity-50 mb-3">
          <i class="bx <%= @classrooms.any? ? 'bx-search-alt' : 'bx-folder-open' %>"></i>
        </div>
        <h3 class="text-white fw-light">Selecione uma <strong>Turma</strong> e um <strong>Aluno</strong>.</h3>
      </div>
    <% else %>

      <%# --- SEÇÃO RPG: PERFIL DO ALQUIMISTA --- %>
      <div class="row mb-4">
        <div class="col-12">
          <div class="content-card-purple p-4 shadow-lg border-rpg-gold">
            <div class="row align-items-center">
              <div class="col-md-4 border-end border-secondary">
                <div class="d-flex align-items-center">
                  <div class="lvl-hex me-3">
                    <span class="lvl-number"><%= @student.level %></span>
                  </div>
                  <div>
                    <h4 class="text-white fw-bold mb-0"><%= @student.name %></h4>
                    <span class="badge bg-purple-dim text-purple-neon border border-purple-neon px-3">
                      <i class="bx bxs-crown me-1"></i><%= @student.title %>
                    </span>
                  </div>
                </div>
              </div>
              <div class="col-md-5 px-4">
                <div class="d-flex justify-content-between mb-2">
                  <span class="label-neon-small">Progresso do Nível</span>
                  <span class="label-neon-small text-purple-neon"><%= @student.xp %> / <%= @student.xp_needed_for_next_level %> XP</span>
                </div>
                <div class="progress-neon" style="height: 12px;">
                  <div class="progress-bar-purple" style="width: <%= @student.rpg_progress_percentage %>%"></div>
                </div>
              </div>
              <div class="col-md-3 text-center">
                <div class="d-flex justify-content-center gap-2">
                  <% @student.badges.limit(4).each do |badge| %>
                    <div class="badge-icon-mini" title="<%= badge.name %>: <%= badge.description %>">
                      <i class="bi <%= badge.icon %>"></i>
                    </div>
                  <% end %>
                  <% if @student.badges.count > 4 %>
                    <div class="badge-icon-mini bg-secondary">+<%= @student.badges.count - 4 %></div>
                  <% end %>
                </div>
                <small class="text-white-50 mt-2 d-block">Medalhas Conquistadas</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# --- SEÇÃO 1: FILTROS DE PERÍODO E DISCIPLINAS COMPONENTES (ANEXO 2) --- %>
      <div class="content-card-purple p-3 mb-4 shadow-lg">
        <div class="row align-items-center g-3">
          <div class="col-xl-4 col-lg-12">
            <h5 class="fw-bold text-white mb-0">
              <i class="bx bx-calendar text-purple-neon me-2"></i>Período de Análise
            </h5>
            <small class="text-white-50">Dados de: <strong class="text-purple-neon"><%= @subject&.name || "Todos os Componentes" %></strong></small>
          </div>
          
          <div class="col-xl-8 col-lg-12">
            <div class="d-flex flex-wrap justify-content-xl-end align-items-center gap-3">
              <div class="btn-group-neon p-1 rounded-pill">
                <% [
                  { key: 'weekly', label: 'Semana' }, { key: 'monthly', label: 'Mês' },
                  { key: '1b', label: '1ºB' }, { key: '2b', label: '2ºB' },
                  { key: '3b', label: '3ºB' }, { key: '4b', label: '4ºB' }
                ].each do |btn| %>
                  <%= link_to btn[:label], root_path(student_id: @student.id, classroom_id: @classroom.id, subject_id: params[:subject_id], period: btn[:key]), 
                      class: "btn-period #{ @period_filter == btn[:key] ? 'active' : '' }" %>
                <% end %>
              </div>

              <%= form_with url: root_path, method: :get, local: true, class: "date-picker-neon" do |f| %>
                <%= f.hidden_field :student_id, value: @student.id %>
                <%= f.hidden_field :classroom_id, value: @classroom.id %>
                <%= f.hidden_field :subject_id, value: params[:subject_id] %>
                <div class="d-flex align-items-center px-2">
                  <%= f.date_field :start_date, value: @start_date, class: "input-date-neon text-white" %>
                  <span class="text-white small mx-2">à</span>
                  <%= f.date_field :end_date, value: @end_date, class: "input-date-neon text-white" %>
                </div>
                <button type="submit" class="btn-search-neon">
                  <i class="bx bx-search-alt-2"></i>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <%# --- NOVA ADIÇÃO: TAGS DINÂMICAS DE COMPONENTES CURRICULARES --- %>
        <div class="row mt-3 border-top border-secondary pt-3">
          <div class="col-12">
            <small class="label-neon-small text-lavender d-block mb-2"><i class="bx bx-category me-1"></i>Análise por Matéria de <%= @student.name.split.first %>:</small>
            <div class="d-flex flex-wrap gap-2">
              <%# Tag para limpar filtro de disciplina e ver tudo combinado %>
              <%= link_to root_path(student_id: @student.id, classroom_id: @classroom.id, period: @period_filter, subject_id: nil), 
                          class: "badge-subject-tag #{ params[:subject_id].blank? ? 'active' : '' }" do %>
                Geral (Todas)
              <% end %>

              <%# Loop que pega as disciplinas injetadas pela turma %>
              <% if @subjects_in_classroom.present? %>
                <% @subjects_in_classroom.each do |sub| %>
                  <% is_active = params[:subject_id].to_i == sub.id %>
                  <%= link_to root_path(student_id: @student.id, classroom_id: @classroom.id, period: @period_filter, subject_id: sub.id), 
                              class: "badge-subject-tag #{ is_active ? 'active' : '' }" do %>
                    <%= sub.name %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# --- SEÇÃO 2: CARDS DE PERCENTUAL DE FREQUÊNCIA --- %>
      <div class="row g-3 mb-4">
        <% [
          { label: 'Semanal', valor: @freq_semanal },
          { label: 'Mensal', valor: @freq_mensal },
          { label: 'Bimestral', valor: @freq_bimestral },
          { label: 'Anual', valor: @freq_anual }
        ].each do |item| %>
          <div class="col-md-3">
            <% is_good = (item[:valor] || 0) >= 75 %>
            <div class="stat-card-neon h-100 <%= is_good ? 'glow-success' : 'glow-danger' %>">
              <small class="label-neon-small text-white-50 d-block mb-2"><%= item[:label] %></small>
              <div class="d-flex justify-content-between align-items-end">
                <h2 class="fw-bold mb-0 text-white"><%= item[:valor] || 0 %>%</h2>
                <span class="badge bg-dark-dim text-white border-0" style="font-size: 0.65rem;">META 75%</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <%# --- QUADROS REAIS DA CHAMADA (CORES NEON DARK) --- %>
      <div class="row g-3 mb-4">
        <% [
          { label: 'Total Aulas', valor: @total_aulas_dadas, icon: 'bx-chalkboard', color: '#bc13fe', glow: 'rgba(188, 19, 254, 0.3)' },
          { label: 'Presenças', valor: @total_presencas, icon: 'bx-check-double', color: '#39ff14', glow: 'rgba(57, 255, 20, 0.3)' },
          { label: 'Faltas', valor: @total_faltas, icon: 'bx-x', color: '#ff3131', glow: 'rgba(255, 49, 49, 0.3)' },
          { label: 'Justificadas', valor: @total_justificadas, icon: 'bx-file', color: '#00d4ff', glow: 'rgba(0, 212, 255, 0.3)' },
          { label: 'Atrasos', valor: @total_atrasos, icon: 'bx-time-five', color: '#ffcc00', glow: 'rgba(255, 204, 0, 0.3)' }
        ].each do |card| %>
          <div class="col">
            <div class="stat-card-neon h-100" style="border: 1px solid <%= card[:color] %>44; box-shadow: 0 0 15px <%= card[:glow] %>; background: rgba(20, 20, 33, 0.7);">
              <div class="d-flex align-items-center mb-2">
                <i class="bx <%= card[:icon] %> me-2" style="color: <%= card[:color] %>; font-size: 1.1rem;"></i>
                <small class="label-neon-small text-white-50"><%= card[:label] %></small>
              </div>
              <h3 class="fw-bold mb-0" style="color: <%= card[:color] %>; text-shadow: 0 0 8px <%= card[:color] %>;"><%= card[:valor] || 0 %></h3>
            </div>
          </div>
        <% end %>
      </div>

      <%# --- SEÇÃO 3: LINHA DO TEMPO E STATUS DE ENTREGA --- %>
      <div class="row g-4 mb-4">
        <div class="col-lg-8">
          <div class="content-card-purple h-100 p-4 shadow-lg overflow-visible position-relative">
            <h6 class="fw-bold mb-1 text-white">
              <i class="bx bx-git-commit text-purple-neon me-2"></i>Linha do Tempo de Atividades
            </h6>
            
            <div class="timeline-scroll-area overflow-x-auto pt-5 pb-4" style="min-height: 280px;">
              <div class="d-flex align-items-end gap-5 px-3 position-relative" style="height: 180px;">
                <% if @timeline_data.any? %>
                  <% @timeline_data.each do |item| %>
                    <div class="timeline-column d-flex flex-column align-items-center text-center" style="min-width: 70px; z-index: 2;">
                      
                      <div class="d-flex align-items-end justify-content-center mb-3" style="height: 120px; width: 100%;">
                        <% if item[:fez] %>
                          <div class="activity-bar" 
                               style="height: <%= item[:nota].to_f * 10 %>%; width: 30px; 
                                      background: rgba(188, 19, 254, 0.05); 
                                      border: 1px solid rgba(188, 19, 254, 0.4);
                                      box-shadow: 0 0 15px rgba(188, 19, 254, 0.1);
                                      position: relative; border-radius: 4px 4px 0 0;">
                            <span class="fw-bold" style="position: absolute; top: -35px; left: 50%; transform: translateX(-50%);
                                  color: <%= item[:nota].to_f >= 6 ? '#39ff14' : '#ffcc00' %>;
                                  text-shadow: 0 0 10px <%= item[:nota].to_f >= 6 ? 'rgba(57,255,20,0.5)' : 'rgba(255,204,0,0.5)' %>; font-size: 0.9rem; white-space: nowrap;">
                              <%= item[:nota] %>
                            </span>
                          </div>
                        <% else %>
                          <div class="text-danger-neon fw-bold fs-2 animate-pulse-neon" style="text-shadow: 0 0 15px #ff3131; line-height: 1;">
                            <i class="bx bx-x"></i>
                          </div>
                        <% end %>
                      </div>

                      <div class="timeline-node bg-purple-neon mb-2" style="width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 10px #bc13fe;"></div>
                      <div class="fw-bold text-white mb-0" style="font-size: 0.7rem;"><%= item[:data] %></div>
                      <div class="text-white-50 text-truncate" style="font-size: 0.6rem; max-width: 80px;" title="<%= item[:nome] %>">
                        <%= item[:nome] %>
                      </div>
                    </div>
                  <% end %>
                  <div class="position-absolute bg-purple-neon opacity-25" style="height: 2px; width: calc(100% - 40px); bottom: 44px; left: 20px; z-index: 1;"></div>
                <% else %>
                  <div class="text-center w-100 text-white-50 small py-5">Nenhuma atividade pontuada no período.</div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <%# ATUALIZADO: CARD DE STATUS DE ENTREGA ADAPTADO AOS PARÂMETROS DINÂMICOS (ANEXO 1) %>
        <div class="col-lg-4">
          <div class="content-card-purple h-100 p-4 shadow-lg d-flex flex-column">
            <h6 class="fw-bold mb-4 text-white border-bottom border-secondary pb-2">Status de Entrega</h6>
            <div class="row text-center mb-4">
              <div class="col-4">
                <div class="fs-4 fw-bold text-success-neon"><%= @entregas_prazo || 0 %></div>
                <div class="label-neon-small text-lavender">No Prazo</div>
              </div>
              <div class="col-4 border-start border-secondary">
                <div class="fs-4 fw-bold text-warning-neon"><%= @entregas_atraso || 0 %></div>
                <div class="label-neon-small text-lavender">Atraso</div>
              </div>
              <div class="col-4 border-start border-secondary">
                <div class="fs-4 fw-bold text-danger-neon"><%= @nao_entregues || 0 %></div>
                <div class="label-neon-small text-lavender">Pendente</div>
              </div>
            </div>

            <div class="progress-container-neon mb-3">
              <div class="d-flex justify-content-between mb-2">
                <span class="small fw-bold text-white">Taxa de Entrega</span>
                <span class="small fw-bold text-purple-neon"><%= @taxa_entrega_aluno || 0 %>%</span>
              </div>
              <div class="progress-neon">
                <div class="progress-bar-purple" style="width: <%= @taxa_entrega_aluno || 0 %>%"></div>
              </div>
            </div>

            <div class="mt-auto border-top border-secondary pt-3">
              <h6 class="label-neon-small text-purple-neon mb-3">Ranking da Turma</h6>
              <% if @ranking_turma %>
                <% @ranking_turma.each_with_index do |top_s, idx| %>
                  <div class="d-flex align-items-center mb-2">
                    <span class="badge bg-dark-dim me-2"><%= idx + 1 %>º</span>
                    <small class="text-white flex-grow-1 text-truncate"><%= top_s.name.split.first %></small>
                    <small class="text-success fw-bold"><%= top_s.total_xp %> XP</small>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# --- SEÇÃO 4: INSIGHTS DA IA & QUICK WINS --- %>
      <div class="ai-insight-card p-4 shadow-lg mb-4">
        <div class="row align-items-center">
          <div class="col-md-auto mb-3 mb-md-0 text-center">
            <div class="ai-icon-box shadow-lg">
              <i class="bx bxs-magic-wand text-purple-neon fs-3"></i>
            </div>
          </div>
          <div class="col-md px-md-4">
            <h6 class="fw-bold text-white mb-1">Maestro IA: <span class="badge bg-purple-dim text-purple-neon ms-2" style="font-size: 10px;">AÇÕES RÁPIDAS</span></h6>
            <div class="mb-0 text-white small">
              <% if (@freq_mensal || 0) < 75 %>
                O aluno <strong><%= @student.name.split.first %></strong> está com baixa assiduidade. O Maestro sugere intervenção imediata.
              <% elsif (@media_aluno || 0) < 6 %>
                Desempenho acadêmico abaixo do esperado. Recomendado reforço em <strong><%= @subject&.name || 'componentes críticos' %></strong>.
              <% else %>
                Desempenho exemplar! Ótimo momento para reforçar o engajamento positivo com o título de <strong><%= @student.title %></strong>.
              <% end %>
            </div>
          </div>
          <div class="col-md-auto mt-3 mt-md-0 d-flex gap-2">
            <% if (@freq_mensal || 0) < 75 %>
              <button class="btn-quick-win win-danger" onclick="alert('Enviando alerta de frequência...')">
                <i class="bx bx-bell me-1"></i> Alerta Pais
              </button>
            <% elsif (@media_aluno || 0) < 6 %>
              <button class="btn-quick-win win-warning" onclick="alert('Gerando roteiro de estudos...')">
                <i class="bx bx-list-check me-1"></i> Plano de Reforço
              </button>
            <% else %>
              <button class="btn-quick-win win-success" onclick="alert('Parabenizando o aluno!')">
                <i class="bx bx-medal me-1"></i> Parabenizar
              </button>
            <% end %>
            <button class="btn-outline-purple-neon">
              <i class="bx bx-file-blank me-1"></i> Relatório PDF
            </button>
          </div>
        </div>
      </div>

      <%# --- SEÇÃO 5: NOTAS E MÉDIAS --- %>
      <div class="row g-4 mb-4">
        <div class="col-lg-12">
          <div class="content-card-purple p-4 shadow-lg">
            <div class="row align-items-center">
              <div class="col-md-3 text-center border-end border-secondary">
                <p class="label-neon-small text-lavender mb-1">Média do Aluno</p>
                <% media = (@media_aluno || 0) %>
                <div class="display-5 fw-bold <%= media >= 6 ? 'text-success-neon' : 'text-danger-neon' %>">
                  <%= media %>
                </div>
              </div>
              <div class="col-md-3 text-center border-end border-secondary">
                <p class="label-neon-small text-lavender mb-1">Média da Turma</p>
                <div class="display-5 fw-bold text-white-50"><%= @media_turma_notas %></div>
              </div>
              <div class="col-md-6 px-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fw-bold text-white small">Desempenho Comparativo</span>
                  <% nota_diff = ((@media_aluno || 0) - (@media_turma_notas || 0)).round(1) %>
                  <span class="badge <%= nota_diff >= 0 ? 'bg-success-neon shadow-success' : 'bg-danger-neon shadow-danger' %> rounded-pill text-dark fw-bold px-3">
                    <%= nota_diff >= 0 ? '+' : '' %><%= nota_diff %> pts
                  </span>
                </div>
                <div class="progress-neon" style="height: 12px;">
                  <div class="progress-bar-purple" style="width: <%= (@media_aluno || 0) * 10 %>%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    <% end %>
  </div>
</div>

<style>
  :root {
    --bg-dark-master: #0a0a0f;
    --card-bg: #141421;
    --purple-neon: #bc13fe;
    --purple-glow: rgba(188, 19, 254, 0.5);
    --success-neon: #39ff14;
    --success-glow: rgba(57, 255, 20, 0.4);
    --danger-neon: #ff3131;
    --danger-glow: rgba(255, 49, 49, 0.4);
    --warning-neon: #ff9100;
    --lavender-light: #d1d1f0;
    --rpg-gold: #ffcc00;
  }

  .teacher-dashboard-neon { background: var(--bg-dark-master); color: #fff; font-family: 'Inter', sans-serif; }
  .form-select-neon { background-color: rgba(255,255,255,0.1); border: 1px solid rgba(188,19,254,0.3); color: #fff !important; border-radius: 10px; padding: 0.5rem; width: 100%; cursor: pointer; }
  .form-select-neon option { background-color: var(--card-bg); color: #fff; }
  .form-select-neon:focus { background-color: var(--card-bg); border-color: var(--purple-neon); box-shadow: 0 0 10px var(--purple-glow); outline: none; }

  /* ESTILO PARA AS NOVAS TAGS DE MATÉRIA NEON */
  .badge-subject-tag {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--lavender-light);
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .badge-subject-tag:hover {
    background: rgba(188, 19, 254, 0.1);
    border-color: rgba(188, 19, 254, 0.4);
    color: #fff;
  }
  .badge-subject-tag.active {
    background: var(--purple-neon);
    border-color: var(--purple-neon);
    color: #fff;
    box-shadow: 0 0 10px var(--purple-glow);
  }

  .border-rpg-gold { border: 1px solid rgba(255, 204, 0, 0.3) !important; box-shadow: 0 0 20px rgba(255, 204, 0, 0.1); }
  .lvl-hex { background: var(--purple-neon); width: 60px; height: 60px; clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px var(--purple-glow); }
  .lvl-number { font-size: 1.5rem; font-weight: 900; color: #fff; }
  .badge-icon-mini { width: 35px; height: 35px; background: rgba(255,255,255,0.1); border: 1px solid var(--purple-neon); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--rpg-gold); font-size: 1.1rem; }

  .stat-card-neon { transition: all 0.3s ease; border-radius: 1.25rem; padding: 1.5rem; }
  .glow-success { border: 1px solid var(--success-neon) !important; box-shadow: 0 0 15px var(--success-glow); background: linear-gradient(145deg, #141421, #0d210d); }
  .glow-danger { border: 1px solid var(--danger-neon) !important; box-shadow: 0 0 15px var(--danger-glow); background: linear-gradient(145deg, #141421, #210d0d); }
  .text-purple-neon { color: var(--purple-neon) !important; text-shadow: 0 0 10px var(--purple-glow); }
  .text-success-neon { color: var(--success-neon) !important; text-shadow: 0 0 10px var(--success-neon); }
  .text-danger-neon { color: var(--danger-neon) !important; text-shadow: 0 0 10px var(--danger-neon); }
