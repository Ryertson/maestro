<% content_for :title, "Configurações Acadêmicas" %>

<div class="d-flex justify-content-between align-items-center mb-4 px-2">
  <div>
    <h1 class="fw-bold text-dark mb-0" style="letter-spacing: -1px;">Estrutura de Ensino</h1>
    <p class="text-muted small mb-0">Gerencie cursos, séries e identificadores de turmas</p>
  </div>
  <div>
    <%= link_to new_course_path, class: "btn btn-primary rounded-pill px-4 fw-bold shadow-sm" do %>
      <i class="bi bi-plus-lg me-2"></i>Novo Curso
    <% end %>
  </div>
</div>

<div class="row g-4">
  <%# --- COLUNA DA ESQUERDA: LISTA DE CURSOS --- %>
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark"><i class="bx bx-book-bookmark me-2 text-primary"></i>Cursos Cadastrados</h5>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr class="text-uppercase small fw-bold text-muted" style="font-size: 0.7rem;">
              <th class="px-4 py-3">Nome do Curso</th>
              <th class="text-center">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if @courses.any? %>
              <% @courses.each do |course| %>
                <tr>
                  <td class="px-4 py-3 fw-bold text-dark">
                    <i class="bi bi-mortarboard me-2 text-muted"></i><%= course.name %>
                  </td>
                  <td class="text-center">
                    <%= link_to edit_course_path(course), class: "btn btn-sm btn-light rounded-circle" do %>
                      <i class="bi bi-pencil-square text-primary"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="2" class="text-center py-4 text-muted">Nenhum curso cadastrado.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%# --- COLUNA DA DIREITA: CADASTROS RÁPIDOS --- %>
  <div class="col-lg-5">
    <div class="row g-4">
      <%# CARD SÉRIES %>
      <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4">
          <h5 class="fw-bold mb-3 text-dark small text-uppercase"><i class="bi bi-layers me-2 text-warning"></i>Séries (Ex: 1º Ano)</h5>
          <%= form_with(model: Grade.new, class: "mb-3") do |f| %>
            <div class="input-group">
              <%= f.text_field :name, class: "form-control bg-light border-0", placeholder: "Nome da Série" %>
              <%= f.submit "Adicionar", class: "btn btn-dark fw-bold px-3" %>
            </div>
          <% end %>
          
          <div class="d-flex flex-wrap gap-2">
            <% Grade.all.each do |g| %>
              <span class="badge bg-white text-dark border shadow-sm px-3 py-2 rounded-pill fw-normal">
                <%= g.name %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <%# CARD SEÇÕES %>
      <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4">
          <h5 class="fw-bold mb-3 text-dark small text-uppercase"><i class="bi bi-alphabet-uppercase me-2 text-info"></i>Letras/Turmas (Ex: Turma A)</h5>
          <%= form_with(model: Section.new, class: "mb-3") do |f| %>
            <div class="input-group">
              <%= f.text_field :name, class: "form-control bg-light border-0", placeholder: "Identificador" %>
              <%= f.submit "Adicionar", class: "btn btn-dark fw-bold px-3" %>
            </div>
          <% end %>
          
          <div class="d-flex flex-wrap gap-2">
            <% Section.all.each do |s| %>
              <span class="badge bg-white text-primary border border-primary-subtle shadow-sm px-3 py-2 rounded-pill fw-normal">
                <%= s.name %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .input-group .form-control:focus {
    box-shadow: none;
    background-color: #fff !important;
    border: 1px solid #0d6efd !important;
  }
  .badge { transition: all 0.2s; }
  .badge:hover { transform: translateY(-2px); }
</style>