<% 
  # --- LÓGICA DE DADOS EM TEMPO REAL ---
  exibir_faltas = @faltas_exibir || @faltas_count || 0
  exibir_aulas  = @total_aulas || @total_chamadas_realizadas || 0
%>

<div class="dashboard-wrapper-neon">
  <div class="dashboard-container p-4">
    
    <%# --- 1. CABEÇALHO DE BOAS-VINDAS NEON --- %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="welcome-card-neon shadow-lg">
          <div class="d-flex align-items-center">
            <div class="icon-box-neon me-4">
              <i class="bi bi-cpu-fill"></i>
            </div>
            <div>
              <h2 class="fw-bold text-white mb-0">Bem-vindo(a) ao portal <span class="text-cyan-neon">Maestro para Estudantes</span></h2>
              <p class="mb-0 text-white-50 opacity-75">
                Olá, <span class="fw-bold text-white"><%= @student.name %></span>! Confira o desempenho da sua turma: 
                <span class="fw-bold text-white"><%= @student.classroom&.display_name %></span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# --- 2. QUADRO DE ALERTAS NO TOPO --- %>
    <div class="alerts-wrapper mb-5">
      <div class="d-flex align-items-center mb-3">
        <div class="neon-pulse-dot me-2"></div>
        <h6 class="text-label-neon mb-0">Alertas e Notificações</h6>
      </div>

      <%# Busca atividades dos últimos 3 dias da turma específica do aluno %>
      <% recent_alerts = @student.classroom.activities.where('activities.created_at >= ?', 3.days.ago).limit(3) %>
      
      <% if recent_alerts.any? %>
        <% recent_alerts.each do |activity| %>
          <div class="alert-card-neon animate__animated animate__fadeIn mb-3">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center">
                <div class="alert-icon-box me-3">
                  <i class="bx bxs-bell-ring bx-tada"></i>
                </div>
                <div>
                  <div class="alert-title text-white fw-bold">Nova Atividade Lançada!</div>
                  <div class="alert-subtitle">
                    <span class="text-cyan-neon"><%= activity.subject&.name %></span> • <%= activity.name %>
                  </div>
                </div>
              </div>
              <div class="text-end d-none d-md-block">
                <span class="badge-new-neon">NOVO</span>
                <div class="alert-time text-white-50 small mt-1">Lançada há <%= time_ago_in_words(activity.created_at) %></div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="empty-alerts text-center p-4 content-card-neon border-dashed">
          <p class="text-white-50 small mb-0 opacity-50">Nenhuma notificação nova. Você está em dia!</p>
        </div>
      <% end %>
    </div>

    <div class="row g-4">
      <%# --- 3. CARD DE FREQUÊNCIA --- %>
      <div class="col-lg-4">
        <div class="content-card-neon attendance-card-neon h-100 text-center p-4">
          <h6 class="text-label-neon mb-4">Frequência</h6>
      
          <div class="chart-container-neon position-relative mx-auto mb-3" style="height: 180px; width: 180px;">
            <canvas id="studentAttendanceChart"></canvas>
            <div class="position-absolute top-50 start-50 translate-middle chart-center-text">
              <% 
                presence_class = if @percentual_presenca >= 75
                                   'text-green-neon'
                                 elsif @percentual_presenca >= 50
                                   'text-warning-neon'
                                 else
                                   'text-danger-neon'
                                 end
              %>
              <h3 class="fw-bold mb-0 <%= presence_class %>" style="font-size: 2.2rem;"><%= @percentual_presenca %>%</h3>
              <small class="text-white d-block fw-bold" style="font-size: 10px; text-transform: uppercase;">Presença</small>
            </div>
          </div>
      
          <div class="attendance-info-box mt-2">
            <div class="d-flex justify-content-around mb-3">
              <div>
                <label class="text-label-neon d-block" style="font-size: 9px;">Aulas lecionadas</label>
                <strong class="text-green-neon" style="font-size: 1.4rem;"><%= exibir_aulas %></strong>
              </div>
              <div style="border-left: 1px solid rgba(255,255,255,0.1);"></div>
              <div>
                <label class="text-label-neon d-block" style="font-size: 9px;">Faltas registradas</label>
                <strong class="text-danger-neon" style="font-size: 1.4rem;"><%= exibir_faltas %></strong>
              </div>
            </div>

            <div class="mt-3 pt-3 border-top border-secondary border-opacity-25 text-start">
              <label class="text-label-neon mb-2 d-block" style="font-size: 9px;">Filtrar por disciplina</label>
              <%= form_with url: student_portal_root_path, method: :get, local: true, class: "mb-0" do |f| %>
                <%= f.select :subject_id, 
                             options_from_collection_for_select(@subjects_para_filtro || [], :id, :name, @selected_subject_id), 
                             { prompt: "Geral (Todas)" }, 
                             { class: "neon-select-custom", onchange: "this.form.submit()" } %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# --- 4. CARD DE DESEMPENHO POR DISCIPLINA --- %>
      <div class="col-lg-8">
        <div class="content-card-neon h-100 d-flex flex-column">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h6 class="text-label-neon mb-0">Notas por Disciplina</h6>
            <span class="badge-neon-cyan">
              Geral: <%= @entregues %> / <%= @total_atividades %> Concluídas
            </span>
          </div>

          <% if @disciplines_data.any? %>
            <ul class="nav nav-pills mb-4 discipline-tabs" id="disciplineTab" role="tablist">
              <% @disciplines_data.each_with_index do |data, index| %>
                <li class="nav-item" role="presentation">
                  <button class="nav-link <%= 'active' if index == 0 %>" 
                          id="tab-<%= data[:instance].id %>" 
                          data-bs-toggle="pill" 
                          data-bs-target="#pane-<%= data[:instance].id %>" 
                          type="button" role="tab">
                    <%= data[:instance].name %>
                  </button>
                </li>
              <% end %>
            </ul>

            <div class="tab-content flex-grow-1" id="disciplineTabContent">
              <% @disciplines_data.each_with_index do |data, index| %>
                <div class="tab-pane fade <%= 'show active' if index == 0 %>" id="pane-<%= data[:instance].id %>" role="tabpanel">
                  <div class="d-flex gap-3 mb-4">
                    <div class="mini-stat-neon">
                      <small>Frequência na Matéria</small>
                      <div class="<%= data[:percentual] < 75 ? 'text-danger-neon' : 'text-cyan-neon' %> fw-bold">
                        <%= data[:percentual] %>%
                      </div>
                    </div>
                    <div class="mini-stat-neon">
                      <small>Atividades Entregues</small>
                      <div class="text-white fw-bold"><%= data[:progresso_atividades] %></div>
                    </div>
                  </div>

                  <div class="table-responsive">
                    <table class="table table-dark-custom align-middle border-0">
                      <thead>
                        <tr>
                          <th class="ps-0 bg-transparent text-white-50 text-uppercase fw-bold" style="font-size: 10px;">Atividade</th>
                          <th class="text-center bg-transparent text-white-50 text-uppercase fw-bold" style="font-size: 10px;">Nota</th>
                          <th class="bg-transparent text-white-50 text-uppercase fw-bold" style="font-size: 10px;">Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if data[:atividades].any? %>
                          <% data[:atividades].each do |activity| %>
                            <% submission = @student.student_activities.find_by(activity_id: activity.id) %>
                            <tr>
                              <td class="ps-0 bg-transparent">
                                <div class="fw-bold text-white"><%= activity.name %></div>
                                <small class="text-white-50 opacity-50"><%= activity.created_at.strftime("%d/%m") %></small>
                              </td>
                              <td class="text-center bg-transparent">
                                <% if submission&.points.present? %>
                                  <span class="grade-badge <%= submission.points >= 6 ? 'grade-high' : 'grade-low' %>">
                                    <%= submission.points %>
                                  </span>
                                <% else %>
                                  <span class="text-white-50 small">--</span>
                                <% end %>
                              </td>
                              <td class="bg-transparent">
                                <% if submission %>
                                  <span class="status-pill status-delivered">Entregue</span>
                                <% else %>
                                  <span class="status-pill status-missing pulse-red-neon">Não Entregue</span>
                                <% end %>
                              </td>
                            </tr>
                          <% end %>
                        <% else %>
                          <tr><td colspan="3" class="text-center py-4 text-white-50 small">Nenhuma atividade.</td></tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# --- 5. SEÇÃO: CRONOGRAMA DE ATIVIDADES --- %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="content-card-neon">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h6 class="text-label-neon mb-0">Cronograma de Atividades Recentes</h6>
            <i class="bx bx-calendar text-cyan-neon fs-4"></i>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom align-middle border-0">
              <thead>
                <tr>
                  <th class="ps-0 bg-transparent text-white-50 text-uppercase fw-bold" style="font-size: 10px;">Matéria / Lição</th>
                  <th class="text-center bg-transparent text-white-50 text-uppercase fw-bold" style="font-size: 10px;">Postagem</th>
                  <th class="text-center bg-transparent text-white-50 text-uppercase fw-bold" style="font-size: 10px;">Situação</th>
                  <th class="text-end pe-0 bg-transparent text-white-50 text-uppercase fw-bold" style="font-size: 10px;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  recent_activities_list = @student.classroom.activities.order(created_at: :desc).limit(10)
                %>
                <% if recent_activities_list.any? %>
                  <% recent_activities_list.each do |activity| %>
                    <% submission = @student.student_activities.find_by(activity_id: activity.id) %>
                    <tr>
                      <td class="ps-0 bg-transparent">
                        <div class="text-cyan-neon fw-bold" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px;"><%= activity.subject&.name %></div>
                        <div class="fw-bold text-white"><%= activity.name %></div>
                      </td>
                      <td class="text-center bg-transparent">
                        <span class="text-white-50 small"><%= activity.created_at.strftime("%d/%m/%Y") %></span>
                      </td>
                      <td class="text-center bg-transparent">
                        <% if submission %>
                          <span class="status-pill status-delivered">Entregue</span>
                        <% else %>
                          <span class="status-pill status-missing pulse-red-neon">Não Entregue</span>
                        <% end %>
                      </td>
                      <td class="text-end pe-0 bg-transparent">
                        <%= link_to student_portal_activity_path(activity), class: "btn-action-neon-arrow" do %>
                          <i class="bx bx-right-arrow-alt"></i>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr><td colspan="4" class="text-center py-5 text-white-50">Nenhuma atividade registrada no cronograma.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="mt-4 d-flex justify-content-center">
            <%= link_to student_portal_activities_path, class: "btn-neon-main" do %>
              <i class="bx bx-list-check me-2"></i> VER TODAS AS ATIVIDADES
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .dashboard-wrapper-neon { background-color: #0c0c14 !important; min-height: 100vh; font-family: 'Inter', sans-serif; color: #fff; }

  :root {
    --bg-dark-panel: #161625;
    --neon-cyan: #00f3ff;
    --neon-cyan-dim: rgba(0, 243, 255, 0.1);
    --neon-green: #39ff14;
    --neon-yellow: #f1c40f;
    --neon-red: #ff4b5c;
    --neon-red-glow: rgba(255, 75, 92, 0.4);
  }

  .text-white { color: #ffffff !important; }
  .text-white-50 { color: rgba(255, 255, 255, 0.6) !important; }
  .text-label-neon { color: var(--neon-cyan); opacity: 0.8; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }

  /* --- ALERTAS NEON --- */
  .alert-card-neon { 
    background: linear-gradient(90deg, rgba(0, 243, 255, 0.05) 0%, rgba(22, 22, 37, 1) 100%); 
    border-left: 4px solid var(--neon-cyan); 
    padding: 15px 20px; 
    border-radius: 10px; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
  }
  .alert-icon-box { background: var(--neon-cyan-dim); color: var(--neon-cyan); padding: 10px; border-radius: 12px; font-size: 1.5rem; }
  .badge-new-neon { background: var(--neon-cyan); color: #000; font-weight: 800; font-size: 10px; padding: 4px 10px; border-radius: 4px; box-shadow: 0 0 10px var(--neon-cyan); }
  .neon-pulse-dot { width: 8px; height: 8px; background-color: var(--neon-cyan); border-radius: 50%; box-shadow: 0 0 10px var(--neon-cyan); animation: pulse-cyan 2s infinite; }
  
  @keyframes pulse-cyan { 
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 243, 255, 0.7); } 
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 243, 255, 0); } 
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 243, 255, 0); } 
  }

  /* --- BOTÕES E ELEMENTOS --- */
  .btn-neon-main {
    background: transparent; color: var(--neon-cyan); border: 2px solid var(--neon-cyan);
    padding: 12px 30px; border-radius: 50px; font-weight: 800; font-size: 13px;
    letter-spacing: 1px; text-decoration: none; transition: all 0.3s ease;
    display: flex; align-items: center;
  }
  .btn-neon-main:hover { background: var(--neon-cyan); color: #000; box-shadow: 0 0 25px var(--neon-cyan); transform: translateY(-2px); }

  .btn-action-neon-arrow {
    background: var(--neon-cyan-dim); color: var(--neon-cyan); width: 35px; height: 35px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 10px; text-decoration: none; transition: 0.3s;
  }
  .btn-action-neon-arrow:hover { background: var(--neon-cyan); color: #000; }

  .status-pill { padding: 5px 14px; border-radius: 50px; font-size: 10px; font-weight: 800; text-transform: uppercase; border: 1px solid transparent; display: inline-block; }
  .status-delivered { background: rgba(241, 196, 15, 0.1); color: var(--neon-yellow); border-color: var(--neon-yellow); }
  .status-missing { background: rgba(255, 75, 92, 0.1); color: var(--neon-red); border-color: var(--neon-red); }

  .pulse-red-neon { animation: pulse-red 2s infinite; }
  @keyframes pulse-red {
    0% { box-shadow: 0 0 0 0 var(--neon-red-glow); }
    70% { box-shadow: 0 0 0 10px rgba(255, 75, 92, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 75, 92, 0); }
  }

  .welcome-card-neon, .content-card-neon { background: var(--bg-dark-panel); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 20px; padding: 25px; }
  .icon-box-neon { background: var(--neon-cyan-dim); color: var(--neon-cyan); font-size: 2.2rem; padding: 12px; border-radius: 15px; }
  .text-cyan-neon { color: var(--neon-cyan); text-shadow: 0 0 10px rgba(0, 243, 255, 0.5); }
  .text-green-neon { color: var(--neon-green) !important; }
  .text-danger-neon { color: var(--neon-red) !important; }

  .discipline-tabs .nav-link { background: rgba(255, 255, 255, 0.02); color: #fff; border: 1px solid rgba(255, 255, 255, 0.1); font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 10px 18px; border-radius: 12px; margin-right: 8px; }
  .discipline-tabs .nav-link.active { background: var(--neon-cyan) !important; color: #000 !important; border-color: var(--neon-cyan) !important; }
  
  .mini-stat-neon { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05); padding: 12px 18px; border-radius: 15px; flex: 1; }
  .neon-select-custom { background: #0c0c14; border: 1px solid var(--neon-cyan); color: #fff; font-size: 12px; padding: 8px 12px; border-radius: 10px; width: 100%; outline: none; }
  
  .table-dark-custom { color: #fff !important; }
  .grade-badge { padding: 4px 12px; border-radius: 8px; font-weight: 800; font-size: 13px; }
  .grade-high { background: var(--neon-green); color: #000; }
  .grade-low { background: var(--neon-red); color: #fff; }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener("turbo:load", function() {
    const canvas = document.getElementById('studentAttendanceChart');
    if (!canvas) return;
    const existingChart = Chart.getChart(canvas);
    if (existingChart) existingChart.destroy();

    const percentual = <%= @percentual_presenca %>;
    let neonColor = (percentual >= 75) ? '#39ff14' : (percentual >= 50 ? '#ff9100' : '#ff4b5c');

    new Chart(canvas, {
      type: 'doughnut',
      data: {
        datasets: [{
          data: [percentual, 100 - percentual],
          backgroundColor: [neonColor, 'rgba(255, 255, 255, 0.05)'],
          borderWidth: 0,
          borderRadius: 15
        }]
      },
      options: {
        cutout: '85%',
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        animation: { duration: 1500, easing: 'easeOutQuart' }
      }
    });
  });
</script>