<%# --- TÍTULO DA PÁGINA --- %>
<div class="row mb-4">
  <div class="col-12">
    <h2 class="text-cyan-neon fw-bold">
      <i class="bi bi-graph-up-arrow me-2"></i>Desempenho Acadêmico
    </h2>
    <p class="text-muted small uppercase">Acompanhe seu progresso e médias do ano letivo 2026</p>
  </div>
</div>

<%# --- CARDS DE RESUMO --- %>
<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="card-neon-summary cyan">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-white-50 small fw-bold text-uppercase">Média de Pontos</span>
          <i class="bi bi-mortarboard fs-4 text-cyan-neon"></i>
        </div>
        <div class="d-flex align-items-baseline">
          <h2 class="text-white fw-bold mb-0"><%= @average_general %></h2>
          <span class="ms-2 text-cyan-neon small">Global</span>
        </div>
        <div class="progress mt-3 bg-dark-soft" style="height: 6px;">
          <div class="progress-bar glow-cyan" role="progressbar" style="width: <%= [@average_general.to_f * 10, 100].min %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card-neon-summary purple">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-white-50 small fw-bold text-uppercase">Melhor Desempenho</span>
          <i class="bi bi-star-fill fs-4 text-purple-neon"></i>
        </div>
        <h4 class="text-white fw-bold mb-0 text-truncate"><%= @best_subject %></h4>
        <span class="text-purple-neon fw-bold">Destaque</span>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card-neon-summary blue">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-white-50 small fw-bold text-uppercase">Frequência</span>
          <i class="bi bi-calendar-check fs-4 text-blue-neon"></i>
        </div>
        <div class="d-flex align-items-baseline">
          <h2 class="text-white fw-bold mb-0"><%= @attendance %>%</h2>
          <span class="ms-2 text-muted small">Meta: 75%</span>
        </div>
        <div class="progress mt-3 bg-dark-soft" style="height: 6px;">
          <div class="progress-bar bg-info" role="progressbar" style="width: <%= @attendance %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card-neon-summary gold">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-white-50 small fw-bold text-uppercase">Status</span>
          <i class="bi bi-shield-check fs-4 text-gold-neon"></i>
        </div>
        <h4 class="text-gold-neon fw-bold mb-0">
          <%= @average_general.to_f >= 7.0 ? "APROVADO" : "EM ANÁLISE" %>
        </h4>
        <span class="text-white-50 small">Baseado nos Points</span>
      </div>
    </div>
  </div>
</div>

<%# --- SEÇÃO DE CONQUISTAS (BADGES) --- %>
<div class="row mb-5">
  <div class="col-12">
    <div class="card bg-glass border-0 p-4">
      <h6 class="text-white-50 small fw-bold text-uppercase mb-4">Conquistas de Prestígio</h6>
      <div class="d-flex flex-wrap gap-4">
        <% if @badges && @badges.any? %>
          <% @badges.each do |badge| %>
            <div class="d-flex align-items-center bg-dark-soft p-3 rounded-4 border border-secondary border-opacity-10 achievement-item">
              <div class="icon-box-badge me-3 <%= badge[:color] %>">
                <i class="bi <%= badge[:icon] %> fs-3"></i>
              </div>
              <div>
                <div class="text-white fw-bold mb-0"><%= badge[:name] %></div>
                <div class="text-muted-dim small"><%= badge[:desc] %></div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-muted-dim small uppercase italic py-2 ps-2">Continue evoluindo para desbloquear medalhas.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# --- TABELA DE NOTAS --- %>
<div class="card bg-glass border-0 shadow-lg overflow-hidden">
  <div class="card-header bg-dark-header border-bottom border-secondary border-opacity-25 py-3">
    <h5 class="mb-0 text-white fw-bold">Detalhamento de Atividades e Pontos</h5>
  </div>
  <div class="table-responsive">
    <table class="table table-dark-portal align-middle mb-0">
      <thead>
        <tr class="text-white-50 small uppercase border-bottom border-secondary border-opacity-10">
          <th class="ps-4 py-3">Atividade / Conteúdo</th>
          <th class="text-center py-3">Pontos</th>
          <th class="text-center py-3">Data</th>
          <th class="text-end pe-4 py-3">Ações</th>
        </tr>
      </thead>
      <tbody class="text-white">
        <% if @points_records && @points_records.any? %>
          <% @points_records.each do |record| %>
            <tr class="border-bottom border-secondary border-opacity-10">
              <td class="ps-4 py-3">
                <div class="fw-bold text-white">
                  <%= record.activity.present? ? record.activity.name : "Atividade sem nome" %>
                </div>
                <div class="text-muted-dim" style="font-size: 0.7rem;">Registro Acadêmico</div>
              </td>
              <td class="text-center py-3">
                <span class="badge-grade <%= record.points.to_f >= 7.0 ? 'grade-purple' : 'text-warning' %>">
                  <%= record.points %>
                </span>
              </td>
              <td class="text-center py-3">
                <span class="text-muted-dim">
                  <%= record.created_at.strftime("%d/%m/%Y") %>
                </span>
              </td>
              <td class="text-end pe-4 py-3">
                <button class="btn btn-sm btn-outline-cyan rounded-pill px-3">
                  <i class="bi bi-eye"></i>
                </button>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="text-center py-5">
              <p class="text-muted-dim mb-0 small uppercase italic">Nenhum registro de "point" encontrado.</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<style>
  /* --- Estilos de Cores e Fundo --- */
  .bg-glass {
    background: rgba(22, 27, 34, 0.8) !important;
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 20px;
  }

  .bg-dark-header { background: rgba(0, 0, 0, 0.2); }

  /* --- Estilo da Tabela --- */
  .table-dark-portal { background: transparent !important; color: #ffffff !important; }
  .table-dark-portal thead th { background: transparent !important; color: rgba(255,255,255,0.6) !important; letter-spacing: 0.5px; }
  .table-dark-portal tbody td { background: transparent !important; color: #ffffff !important; }

  /* --- Cards de Resumo --- */
  .card-neon-summary {
    background: #161b22;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .card-neon-summary:hover { transform: translateY(-5px); background: #1c2128; }
  .card-neon-summary.cyan { border-bottom: 3px solid #00f2ff; }
  .card-neon-summary.purple { border-bottom: 3px solid #bc13fe; }
  .card-neon-summary.blue { border-bottom: 3px solid #3b82f6; }
  .card-neon-summary.gold { border-bottom: 3px solid #ffd700; }

  /* --- Estilo das Medalhas (Gamificação) --- */
  .achievement-item { transition: all 0.3s ease; cursor: default; min-width: 220px; }
  .achievement-item:hover { transform: scale(1.03); background: rgba(255, 255, 255, 0.07); }
  
  .icon-box-badge {
    width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; border-radius: 12px;
  }
  .icon-box-badge.cyan { color: #00f2ff; background: rgba(0, 242, 255, 0.1); border: 1px solid #00f2ff; box-shadow: 0 0 10px rgba(0, 242, 255, 0.3); }
  .icon-box-badge.gold { color: #ffd700; background: rgba(255, 215, 0, 0.1); border: 1px solid #ffd700; box-shadow: 0 0 10px rgba(255, 215, 0, 0.3); }
  .icon-box-badge.purple { color: #bc13fe; background: rgba(188, 19, 254, 0.1); border: 1px solid #bc13fe; }
  .icon-box-badge.orange { color: #ff5e00; background: rgba(255, 94, 0, 0.1); border: 1px solid #ff5e00; animation: pulse-orange 2s infinite; }
  .icon-box-badge.blue { color: #3b82f6; background: rgba(59, 130, 246, 0.1); border: 1px solid #3b82f6; }

  @keyframes pulse-orange {
    0% { box-shadow: 0 0 0 0 rgba(255, 94, 0, 0.4); }
    70% { box-shadow: 0 0 0 10px rgba(255, 94, 0, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 94, 0, 0); }
  }

  /* --- Neon Helpers --- */
  .text-cyan-neon { color: #00f2ff !important; text-shadow: 0 0 10px rgba(0, 242, 255, 0.4); }
  .text-purple-neon { color: #bc13fe !important; text-shadow: 0 0 10px rgba(188, 19, 254, 0.4); }
  .text-gold-neon { color: #ffd700 !important; text-shadow: 0 0 10px rgba(255, 215, 0, 0.3); }
  .glow-cyan { background-color: #00f2ff !important; box-shadow: 0 0 10px rgba(0, 242, 255, 0.8); }
  .bg-dark-soft { background-color: rgba(255, 255, 255, 0.05) !important; }
  .uppercase { letter-spacing: 1px; font-size: 0.65rem; }
  .text-muted-dim { color: rgba(255, 255, 255, 0.4) !important; }

  /* --- Badges e Botões --- */
  .badge-grade {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: bold;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .grade-purple { color: #bc13fe; border-color: rgba(188, 19, 254, 0.3); }
  .btn-outline-cyan { color: #00f2ff; border-color: #00f2ff; transition: all 0.3s; background: transparent; }
  .btn-outline-cyan:hover { background: #00f2ff; color: #0b0e14; box-shadow: 0 0 15px rgba(0, 242, 255, 0.6); }
</style>