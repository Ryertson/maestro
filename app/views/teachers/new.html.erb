<div class="container-fluid py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
      
      <%# Botão de Voltar %>
      <div class="mb-4">
        <%= link_to teachers_path, class: "text-decoration-none text-muted fw-bold small uppercase" do %>
          <i class="bi bi-arrow-left me-1"></i> VOLTAR PARA LISTAGEM
        <% end %>
      </div>

      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="row g-0">
          <%# Lado Esquerdo: Banner Visual %>
          <div class="col-md-4 bg-primary d-none d-md-flex align-items-center justify-content-center p-4 text-white text-center">
            <div>
              <i class="bi bi-person-badge" style="font-size: 4rem;"></i>
              <h4 class="fw-bold mt-3">Novo Mestre</h4>
              <p class="small opacity-75">Cadastre os dados básicos para começar a atribuir turmas e planejar aulas.</p>
            </div>
          </div>

          <%# Lado Direito: Formulário %>
          <div class="col-md-8 bg-white">
            <div class="card-body p-4 p-md-5">
              <h2 class="fw-bold text-dark mb-4">Cadastro de Professor</h2>

              <%= form_with(model: @teacher, local: true) do |f| %>
                <% if @teacher.errors.any? %>
                  <div class="alert alert-danger border-0 rounded-4 small">
                    <h6 class="fw-bold"><%= pluralize(@teacher.errors.count, "erro") %> impediram o salvamento:</h6>
                    <ul class="mb-0">
                      <% @teacher.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <div class="mb-3">
                  <label class="form-label fw-bold small text-muted">NOME COMPLETO</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-person text-primary"></i></span>
                    <%= f.text_field :name, class: "form-control bg-light border-0 py-2", placeholder: "Ex: João Silva", required: true %>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-7 mb-3">
                    <label class="form-label fw-bold small text-muted">E-MAIL INSTITUCIONAL</label>
                    <div class="input-group">
                      <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-primary"></i></span>
                      <%= f.email_field :email, class: "form-control bg-light border-0 py-2", placeholder: "joao@escola.com" %>
                    </div>
                  </div>
                  <div class="col-md-5 mb-3">
                    <label class="form-label fw-bold small text-muted">TELEFONE</label>
                    <div class="input-group">
                      <span class="input-group-text bg-light border-0"><i class="bi bi-whatsapp text-primary"></i></span>
                      <%= f.text_field :phone, class: "form-control bg-light border-0 py-2", placeholder: "(84) 9..." %>
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-bold small text-muted">BIOGRAFIA / OBSERVAÇÕES</label>
                  <%= f.text_area :bio, class: "form-control bg-light border-0", rows: 3, placeholder: "Breve resumo sobre a formação ou especialidade..." %>
                </div>

                <div class="d-grid gap-2">
                  <%= f.submit "Salvar Professor", class: "btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" %>
                  <%= link_to "Cancelar", teachers_path, class: "btn btn-link text-muted fw-bold text-decoration-none" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .input-group-text { border-radius: 12px 0 0 12px !important; }
  .form-control { border-radius: 0 12px 12px 0 !important; }
  .form-control:focus { background-color: #fff !important; box-shadow: none; border: 1px solid #0d6efd !important; }
  .rounded-pill { border-radius: 50px !important; }
  .bg-primary { background: linear-gradient(135deg, #0d6efd 0%, #004dbb 100%) !important; }
</style>
