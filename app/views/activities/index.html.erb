<div class="container-fluid px-4 py-4">

  <%# --- 1. CABEÇALHO --- %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-white fw-bold h3 mb-0">Gestão de Atividades e Notas</h1>
    <div class="glass-card px-3 py-2 d-flex align-items-center gap-2">
      <span class="label-neon-small mb-0" style="color: var(--neon-orange);">
        <i class="bi bi-lightning-fill"></i> Pendências Ativas
      </span>
      <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="togglePendencias">
      </div>
    </div>
  </div>

  <%# --- 2. FORMULÁRIO DE NOVA ATIVIDADE --- %>
  <div class="glass-card p-4 border-glow-purple mb-5">
    <h5 class="text-purple-neon fw-bold mb-4">Planejar Nova Atividade</h5>
    <%= form_with(model: @activity, local: true) do |f| %>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="label-neon-small mb-1">Turma Destino</label>
          <%= f.collection_select :classroom_id, @available_classrooms, :id, :full_name_info, 
              { prompt: "Selecionar Turma" }, { class: "form-select form-control-glass" } %>
        </div>
        <div class="col-md-3">
          <label class="label-neon-small mb-1">Vincular à Aula</label>
          <%= f.collection_select :lesson_id, @lessons_for_select, :id, :topic_name, 
              { prompt: "Selecionar Aula" }, { class: "form-select form-control-glass" } %>
        </div>
        <div class="col-md-4">
          <label class="label-neon-small mb-1">Título da Atividade</label>
          <%= f.text_field :name, class: "form-control form-control-glass", placeholder: "Ex: Avaliação de Química" %>
        </div>
        <div class="col-md-2">
          <label class="label-neon-small mb-1">Pontos (Valor)</label>
          <%= f.text_field :points, class: "form-control form-control-glass", placeholder: "10.0" %>
        </div>
        <div class="col-md-3">
          <label class="label-neon-small mb-1">Data de Entrega</label>
          <%= f.date_field :date, class: "form-control form-control-glass" %>
        </div>
        <div class="col-md-3">
          <label class="label-neon-small mb-1">Tipo de Atividade</label>
          <%= f.select :activity_type, ["Prova", "Lista de Exercícios", "Trabalho", "Visto"], 
              { prompt: "Tipo..." }, { class: "form-select form-control-glass" } %>
        </div>
        <div class="col-md-6 text-end">
          <button type="submit" class="btn btn-outline-purple-neon px-5 fw-bold">
            <i class="bi bi-plus-circle me-2"></i>Salvar Atividade no Banco
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <%# --- 3. ABAS DE NAVEGAÇÃO (CORES PERSONALIZADAS) --- %>
  <ul class="nav nav-tabs nav-tabs-maestro mb-4" id="activityTabs" role="tablist">
    <li class="nav-item">
      <button class="nav-link active tab-azul" data-bs-toggle="tab" data-bs-target="#lancamento">
        <i class="bi bi-pencil-fill me-2"></i>Atividade Atual
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link tab-vermelha" data-bs-toggle="tab" data-bs-target="#atividades-banco">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Atividades Não Corrigidas
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link tab-roxa" data-bs-toggle="tab" data-bs-target="#atividades-concluidas">
        <i class="bi bi-check-all me-2"></i>Atividades Corrigidas
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <%# --- ABA: ATIVIDADE ATUAL (LANÇAMENTO) --- %>
    <div class="tab-pane fade show active" id="lancamento">
      <% if @active_activity %>
        <div class="glass-card p-4 border-glow-blue mb-5">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="text-white fw-bold mb-0">
              Lançamento: <span style="color: var(--neon-blue);"><%= @active_activity.name %></span>
            </h4>
            
            <%= button_to mark_as_corrected_activity_path(@active_activity), method: :patch, class: "btn-concluir-verde" do %>
              <i class="bi bi-check-lg me-2"></i>Marcar como Corrigida
            <% end %>
          </div>

          <%= form_tag save_submissions_activities_path, method: :post do %>
            <%= hidden_field_tag :current_activity_id, @active_activity.id %>
            
            <div class="table-responsive-scroll" style="max-height: 500px;">
              <table class="table table-dark-neon table-hover align-middle">
                <thead class="sticky-thead">
                  <tr>
                    <th class="ps-4">Estudante</th>
                    <th class="text-center">Turma</th>
                    <th class="text-center">Status de Entrega</th>
                    <th class="text-center" style="width: 150px;">Nota / Pontos</th>
                    <th class="text-end pe-4">Detalhes</th>
                  </tr>
                </thead>
                <tbody>
                  <% @students.each do |student| %>
                    <% sa = @active_student_activities[student.id] %>
                    <tr>
                      <td class="ps-4 fw-bold text-white"><%= student.name.upcase %></td>
                      <td class="text-center">
                        <span class="badge border border-secondary text-white-50 small">
                          <%= student.classroom.full_name_info %>
                        </span>
                      </td>
                      <td class="text-center">
                        <% status_class = case sa&.status
                           when 'Entregue' then 'status-entregue'
                           when 'Não Entregue' then 'status-nao-entregue'
                           when 'Entregue com Atraso' then 'status-atraso'
                           else 'status-pendente'
                           end 
                        %>
                        <select name="statuses[<%= student.id %>]" 
                                class="form-select form-control-glass text-center-select <%= status_class %> mx-auto" 
                                style="width: 210px;"
                                onchange="this.className='form-select form-control-glass text-center-select mx-auto ' + (this.value == 'Entregue' ? 'status-entregue' : this.value == 'Não Entregue' ? 'status-nao-entregue' : this.value == 'Entregue com Atraso' ? 'status-atraso' : 'status-pendente')">
                          <option value="Pendente" <%= 'selected' if sa&.status == 'Pendente' %>>Pendente</option>
                          <option value="Entregue" <%= 'selected' if sa&.status == 'Entregue' %>>Entregue</option>
                          <option value="Entregue com Atraso" <%= 'selected' if sa&.status == 'Entregue com Atraso' %>>Entregue com Atraso</option>
                          <option value="Não Entregue" <%= 'selected' if sa&.status == 'Não Entregue' %>>Não Entregue</option>
                        </select>
                      </td>
                      <td class="text-center">
                        <input type="number" name="student_points[<%= student.id %>]" 
                               step="0.1" class="form-control form-control-glass text-center mx-auto" 
                               value="<%= sa&.points %>" placeholder="0.0" style="width: 100px;">
                      </td>
                      <td class="text-end pe-4">
                        <%= link_to activity_path(@active_activity, student_id: student.id), class: "text-purple-neon" do %>
                          <i class="bi bi-eye-fill"></i>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="text-center mt-4">
              <button type="submit" class="btn btn-outline-purple-neon btn-lg px-5 fw-bold">
                <i class="bi bi-cloud-arrow-up me-2"></i>Salvar Todos os Lançamentos
              </button>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="glass-card p-5 text-center">
          <h5 class="text-white-50">Nenhuma atividade selecionada.</h5>
          <p class="small">Selecione uma atividade abaixo para começar.</p>
        </div>
      <% end %>
    </div>

    <%# --- ABA: ATIVIDADES NÃO CORRIGIDAS --- %>
    <div class="tab-pane fade" id="atividades-banco">
      <div class="glass-card border-glow-orange">
        <div class="table-responsive-scroll" style="max-height: 500px;">
          <table class="table table-dark-neon table-hover align-middle mb-0">
            <thead class="sticky-thead">
              <tr>
                <th class="ps-4">Atividade Pendente</th>
                <th class="text-center">Turma</th>
                <th class="text-center">Status</th>
                <th class="text-center">Engajamento</th>
                <th class="text-end pe-4">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% @pending_activities.each do |act| %>
                <tr>
                  <td class="ps-4">
                    <span class="text-white fw-bold"><%= act.name %></span>
                  </td>
                  <td class="text-center">
                    <span class="badge border border-secondary text-white-50"><%= act.classroom.display_name %></span>
                  </td>
                  <td class="text-center">
                    <span class="badge-status-neon badge-neon-red">Não Corrigida</span>
                  </td>
                  <td class="text-center">
                    <span class="text-purple-neon fw-bold">
                      <%= act.student_activities.where(status: 'Entregue').count %>/<%= act.classroom.students.count %>
                    </span>
                  </td>
                  <td class="text-end pe-4">
                    <%= link_to activities_path(current_activity_id: act.id), class: "btn btn-sm btn-outline-purple-neon" do %>
                      <i class="bi bi-pencil-square me-1"></i> Abrir Lançamento
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%# --- NOVA ABA: ATIVIDADES CORRIGIDAS --- %>
    <div class="tab-pane fade" id="atividades-concluidas">
      <div class="glass-card border-glow-purple">
        <div class="table-responsive-scroll" style="max-height: 500px;">
          <table class="table table-dark-neon table-hover align-middle mb-0">
            <thead class="sticky-thead">
              <tr>
                <th class="ps-4">Atividade Concluída</th>
                <th class="text-center">Turma</th>
                <th class="text-center">Status</th>
                <th class="text-center">Aproveitamento Médio</th>
                <th class="text-end pe-4">Ações</th>
              </tr>
            </thead>
            <tbody>
              <%# Busca todas as atividades com status corrigida %>
              <%# Adicionamos o &. para que, se for nil, ele não quebre a página %>
              <% @all_activities&.where(status: 'corrigida')&.order(date: :desc)&.each do |act| %>
                <tr>
                  <td class="ps-4">
                    <span class="text-white fw-bold"><%= act.name %></span>
                    <div class="text-white-50 small"><%= act.date&.strftime("%d/%m/%Y") %></div>
                  </td>
                  <td class="text-center">
                    <span class="badge border border-secondary text-white-50"><%= act.classroom.display_name %></span>
                  </td>
                  <td class="text-center">
                    <span class="badge-status-neon badge-neon-green">Finalizada</span>
                  </td>
                  <td class="text-center">
                     <span class="text-purple-neon fw-bold">
                       <% avg_points = act.student_activities.average(:points) || 0 %>
                       <%= number_with_precision(avg_points, precision: 1) %> / <%= act.points %>
                     </span>
                  </td>
                  <td class="text-end pe-4">
                    <%= link_to activities_path(current_activity_id: act.id), class: "btn btn-sm btn-outline-purple-neon" do %>
                      <i class="bi bi-eye-fill me-1"></i> Revisar Notas
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .text-center-select {
    text-align: center;
    text-align-last: center;
  }

  /* Abas Ativas */
  .nav-tabs-maestro .nav-link.active.tab-azul {
    color: var(--neon-blue) !important;
    border-bottom: 2px solid var(--neon-blue) !important;
    text-shadow: 0 0 10px var(--neon-blue-glow);
    background: rgba(36, 182, 255, 0.1) !important;
  }

  .nav-tabs-maestro .nav-link.active.tab-vermelha {
    color: #ff3131 !important;
    border-bottom: 2px solid #ff3131 !important;
    text-shadow: 0 0 10px rgba(255, 49, 49, 0.4);
    background: rgba(255, 49, 49, 0.1) !important;
  }

  .nav-tabs-maestro .nav-link.active.tab-roxa {
    color: var(--purple-neon) !important;
    border-bottom: 2px solid var(--purple-neon) !important;
    text-shadow: 0 0 10px var(--purple-glow);
    background: rgba(188, 19, 254, 0.1) !important;
  }

  .btn-concluir-verde {
    background: var(--neon-green) !important;
    color: #000 !important;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 1px;
    box-shadow: 0 0 15px var(--neon-green-glow);
    transition: all 0.3s ease;
  }

  .btn-concluir-verde:hover {
    transform: scale(1.05);
    box-shadow: 0 0 25px var(--neon-green);
  }

  .form-control-glass { font-size: 0.9rem; }
  .table-dark-neon td { border-bottom: 1px solid rgba(255, 255, 255, 0.03) !important; }
</style>