<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-0">Lançamento de Notas: <%= @activity.name %></h2>
      <p class="text-muted">Data: <%= @activity.date.strftime("%d/%m/%Y") %> | Turma: <%= @activity.lesson&.grade_level %></p>
    </div>
    <%= link_to activities_path, class: "btn btn-outline-secondary rounded-pill" do %>
      Voltar
    <% end %>
  </div>

  <div class="card shadow-sm border-0 rounded-3">
    <%= form_with url: save_submissions_activities_path, method: :post do |f| %>
      <%= hidden_field_tag :current_activity_id, @activity.id %>
      
      <table class="table align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th>Aluno</th>
            <th class="text-center">Status</th>
            <th class="text-center">Nota</th>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
            <% submission = @submissions[student.id] %>
            <tr>
              <td><strong><%= student.name %></strong></td>
              <td class="text-center">
                <%= select_tag "submissions[#{student.id}][status]", 
                    options_for_select(["Pendente", "Entregou", "Não Entregou"], submission&.status || "Pendente"),
                    class: "form-select form-select-sm" %>
              </td>
              <td class="text-center">
                <%= number_field_tag "submissions[#{student.id}][grade]", 
                    submission&.points, 
                    step: 0.1, class: "form-control form-control-sm mx-auto", style: "width: 80px;" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <div class="card-footer text-end bg-white py-3">
        <%= f.submit "Salvar Notas", class: "btn btn-primary px-4 shadow-sm" %>
      </div>
    <% end %>
  </div>
</div>