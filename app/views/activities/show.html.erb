<div class="container-fluid py-4">
  <%# --- CABEÇALHO DA ATIVIDADE --- %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <%= link_to activities_path, class: "text-decoration-none small text-muted mb-2 d-block" do %>
        <i class="bi bi-arrow-left"></i> Voltar para Atividades
      <% end %>
      <h1 class="fw-bold text-secondary mb-0"><%= @activity.name %></h1>
      <p class="text-muted">
        Turma: <span class="badge bg-dark"><%= @activity.classroom.full_name_info %></span> | 
        Prazo: <span class="text-info fw-bold"><%= @activity.teacher_delivery_date&.strftime("%d/%m/%Y") || 'Sem data' %></span>
      </p>
    </div>
    <div class="btn-group">
      <%= link_to 'Editar Atividade', edit_activity_path(@activity), class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <%# --- QUADRO DE ENTREGAS --- %>
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: #1e1e2d;">
    <div class="card-header bg-dark border-secondary py-3">
      <h5 class="text-white mb-0 fw-bold">Controle de Entregas</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th class="ps-4">Estudante</th>
            <th class="text-center">Status de Entrega</th>
            <th class="text-center">Data da Entrega</th>
            <th class="text-center">Nota/Pontos</th>
            <th class="text-end pe-4">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @activity.student_activities.includes(:student).order('students.name').each do |sa| %>
            <tr id="row-sa-<%= sa.id %>">
              <td class="ps-4 fw-bold text-white-50">
                <%= sa.student.name.upcase %>
              </td>
              <td class="text-center">
                <span id="badge-status-<%= sa.id %>" class="badge rounded-pill <%= status_class(sa.status) %> p-2 px-3">
                  <%= sa.status %>
                <% if sa.status == 'Entregue' && sa.delivered_at.present? && @activity.teacher_delivery_date.present? && sa.delivered_at > @activity.teacher_delivery_date %>
                  <small class="d-block text-warning" style="font-size: 0.6rem;">Com Atraso</small>
                <% end %>
                </span>
              </td>
              <td class="text-center text-muted">
                <%= sa.delivered_at&.strftime("%d/%m/%Y") || '-' %>
              </td>
              <td class="text-center fw-bold text-info">
                <%= sa.points || '0.0' %>
              </td>
              <td class="text-end pe-4">
                <div class="dropdown">
                  <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    Alterar Status
                  </button>
                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg">
                    <% ['Pendente', 'Entregue', 'Não Entregue'].each do |status| %>
                      <li>
                        <%# Ajuste para o controller que criaremos %>
                        <%= link_to status, update_status_activity_path(@activity, student_activity_id: sa.id, new_status: status), 
                            method: :patch, remote: true, class: "dropdown-item fw-bold" %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .badge.bg-pending { background-color: #6c757d; }
  .badge.bg-success { background-color: #198754; }
  .badge.bg-danger { background-color: #dc3545; }
  .table-hover tbody tr:hover { background-color: rgba(255,255,255,0.05) !important; }
</style>
