<div id="<%= dom_id activity %>">
  <div>
    <strong>Name:</strong>
    <%= activity.name %>
  </div>

  <div>
    <strong>Activity type:</strong>
    <%= activity.activity_type %>
  </div>

  <div>
    <strong>Student delivery date:</strong>
    <%= activity.student_delivery_date %>
  </div>

  <div>
    <strong>Teacher delivery date:</strong>
    <%= activity.teacher_delivery_date %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= activity.status %>
  </div>

  <div>
    <strong>Grade:</strong>
    <%= activity.grade %>
  </div>

</div>
