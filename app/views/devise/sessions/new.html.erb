<div class="auth-container d-flex align-items-center justify-content-center" style="min-height: 100vh; background: #0b0b14; position: relative; overflow: hidden;">
  
  <%# Efeito de Ambientação Neon %>
  <div class="glow-bg" style="position: absolute; width: 500px; height: 500px; background: <%= resource_name == :professor ? 'rgba(188, 19, 254, 0.05)' : 'rgba(0, 212, 255, 0.05)' %>; filter: blur(150px); border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>

  <div class="container position-relative" style="z-index: 2;">
    <div class="row justify-content-center">
      <div class="col-12 col-md-6 col-lg-5">
        
        <div class="card-maestro-neon-main p-4 p-md-5 <%= resource_name == :student_user ? 'border-cyan' : 'border-purple' %>">
          
          <%# --- CABEÇALHO --- %>
          <div class="text-center mb-5">
            <div class="brand-logo mb-3">
              <i class="bx <%= resource_name == :professor ? 'bxs-graduation text-purple-neon' : 'bxs-rocket text-cyan-neon' %>" style="font-size: 3.5rem; filter: drop-shadow(0 0 12px <%= resource_name == :professor ? '#bc13fe' : '#00d4ff' %>);"></i>
            </div>
            <h2 class="fw-bold text-white tracking-wider">MAESTRO</h2>
            <p class="text-white-50"><%= resource_name == :professor ? 'Portal do Professor' : 'Portal do Aluno' %></p>
            <div class="neon-line mx-auto <%= resource_name == :professor ? 'bg-purple' : 'bg-cyan' %>"></div>
          </div>

          <%# --- FORMULÁRIO --- %>
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-4">
              <label class="label-neon-small mb-2 <%= resource_name == :professor ? 'text-purple' : 'text-cyan' %>">E-MAIL</label>
              <%= f.email_field :email, autofocus: true, class: "input-maestro-neon-v2", placeholder: "seu@email.com" %>
            </div>

            <div class="mb-4">
              <label class="label-neon-small mb-2 <%= resource_name == :professor ? 'text-purple' : 'text-cyan' %>">SENHA</label>
              <%= f.password_field :password, class: "input-maestro-neon-v2", placeholder: "••••••••" %>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-5">
              <div class="form-check">
                <%= f.check_box :remember_me, class: "form-check-input check-neon-v2" %>
                <label class="text-white-50 small">Lembrar-me</label>
              </div>
              <%= link_to "Esqueceu a senha?", "#", class: "small text-decoration-none #{resource_name == :professor ? 'text-purple-neon' : 'text-cyan-neon'}" %>
            </div>

            <div class="d-grid mb-4">
              <%= f.submit "ENTRAR NO SISTEMA", class: "btn-maestro-main py-3 fw-bold #{resource_name == :professor ? 'btn-purple' : 'btn-cyan'}" %>
            </div>
          <% end %>

          <hr style="border-color: rgba(255,255,255,0.1);">

          <%# --- BOTÃO DE ALTERNÂNCIA --- %>
          <div class="text-center mt-4">
            <% if resource_name == :professor %>
              <p class="text-white-50 small mb-3">Você é um estudante?</p>
              <%= link_to new_student_user_session_path, class: "btn-outline-neon-cyan d-block py-2 text-decoration-none fw-bold" do %>
                <i class="bx bx-rocket me-2"></i>CLIQUE AQUI PARA O PORTAL
              <% end %>
            <% else %>
              <p class="text-white-50 small mb-3">Acesso para docentes?</p>
              <%= link_to new_professor_session_path, class: "btn-outline-neon-purple d-block py-2 text-decoration-none fw-bold" do %>
                <i class="bx bxs-graduation me-2"></i>ÁREA DO PROFESSOR
              <% end %>
            <% end %>
          </div>

          <%# --- RODAPÉ DE GESTÃO (Apenas Professor) --- %>
          <% if resource_name == :professor %>
            <div class="mt-4 text-center">
              <small class="text-white-50 d-block mb-2">Administração e Novos Docentes</small>
              <div class="d-flex justify-content-center gap-3 align-items-center">
                <%= link_to new_professor_registration_path, class: "text-white-50 text-decoration-none small" do %>
                  <i class="bx bx-user-plus me-1"></i>Solicitar Acesso
                <% end %>
                <span class="text-white-50">|</span>
                <%= link_to "#", class: "text-white-50 text-decoration-none small" do %>
                  <i class="bx bx-help-circle me-1"></i>Suporte
                <% end %>
              </div>
            </div>
          <% else %>
             <div class="mt-4 text-center">
              <%= link_to new_student_user_registration_path, class: "text-cyan-neon text-decoration-none small fw-bold" do %>
                <i class="bx bxs-key me-1"></i>PRIMEIRO ACESSO? ATIVE SUA CONTA
              <% end %>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .card-maestro-neon-main {
    background: rgba(20, 20, 33, 0.95);
    border-radius: 24px;
    box-shadow: 0 0 50px rgba(0,0,0,0.6);
    backdrop-filter: blur(10px);
  }
  .border-purple { border: 1px solid rgba(188, 19, 254, 0.4); }
  .border-cyan { border: 1px solid rgba(0, 212, 255, 0.4); }

  .input-maestro-neon-v2 {
    width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px; padding: 12px; color: white; transition: 0.3s;
  }
  .input-maestro-neon-v2:focus { outline: none; border-color: inherit; box-shadow: 0 0 15px rgba(255,255,255,0.1); }

  .btn-maestro-main { border: none; border-radius: 12px; color: white; transition: 0.4s; }
  .btn-purple { background: #bc13fe; box-shadow: 0 0 20px rgba(188, 19, 254, 0.4); }
  .btn-cyan { background: #00d4ff; color: #0b0b14; box-shadow: 0 0 20px rgba(0, 212, 255, 0.4); }
  
  .btn-maestro-main:hover { transform: translateY(-3px); filter: brightness(1.2); }

  .text-purple-neon { color: #bc13fe; }
  .text-cyan-neon { color: #00d4ff; }
  .bg-purple { background: #bc13fe; box-shadow: 0 0 10px #bc13fe; }
  .bg-cyan { background: #00d4ff; box-shadow: 0 0 10px #00d4ff; }
  
  .neon-line { width: 50px; height: 3px; border-radius: 10px; margin-top: 10px; }
  .label-neon-small { font-size: 0.7rem; font-weight: bold; letter-spacing: 1px; }

  .btn-outline-neon-cyan { border: 1px solid #00d4ff; color: #00d4ff; border-radius: 10px; transition: 0.3s; }
  .btn-outline-neon-cyan:hover { background: rgba(0, 212, 255, 0.1); box-shadow: 0 0 15px rgba(0, 212, 255, 0.3); color: #00d4ff; }
  
  .btn-outline-neon-purple { border: 1px solid #bc13fe; color: #bc13fe; border-radius: 10px; transition: 0.3s; }
  .btn-outline-neon-purple:hover { background: rgba(188, 19, 254, 0.1); box-shadow: 0 0 15px rgba(188, 19, 254, 0.3); color: #bc13fe; }
</style>