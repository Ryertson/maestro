<div class="container-fluid px-4 py-4">

  <%# --- Botão de Alternância de Visão (Apenas para Admins) --- %>
  <% if current_professor.admin? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="glass-card border-glow-purple" style="background: linear-gradient(90deg, rgba(111, 66, 193, 0.2) 0%, rgba(78, 115, 223, 0.2) 100%);">
          <div class="card-body d-flex justify-content-between align-items-center py-2 px-4">
            <div class="text-white d-flex align-items-center">
              <i class="bi bi-person-badge-fill fs-4 me-3 text-purple-neon"></i>
              <div>
                <span class="label-neon-small opacity-75">Visão Atual</span>
                <span class="badge badge-neon-purple px-3 text-uppercase">
                  <%= current_professor.view_mode.to_s.humanize %>
                </span>
              </div>
            </div>
            
            <%= button_to toggle_view_mode_path, method: :post, class: "btn btn-outline-purple-neon btn-sm px-4", data: { turbo: false } do %>
              <i class="bi bi-arrow-left-right me-2"></i>
              Mudar para <%= current_professor.modo_professor? ? "Modo Administrador" : "Modo Professor" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  
  <%# --- Cabeçalho e Pesquisa --- %>
  <div class="row align-items-center mb-4">
    <div class="col-md-3">
      <h1 class="text-white fw-bold h3 mb-0">Gestão de Atividades</h1>
    </div>
    <div class="col-md-9">
      <div class="glass-card p-3 border-glow-blue">
        <%= form_tag lessons_path, method: :get, class: "row g-2 justify-content-end" do %>
          <div class="col-md-3">
            <div class="form-floating">
              <%= select_tag :classroom_id, options_from_collection_for_select(@available_classrooms, :id, :full_name_info, params[:classroom_id]), include_blank: "Todas as Turmas", class: "form-select form-control-glass", id: "filterClassroom", onchange: "this.form.submit()" %>
              <label for="filterClassroom" class="text-white-50 small">Filtrar Turma</label>
            </div>
          </div>

          <div class="col-md-3">
            <div class="form-floating">
              <%= select_tag :subject_id, options_from_collection_for_select(@available_subjects, :id, :name, params[:subject_id]), include_blank: "Todas as Disciplinas", class: "form-select form-control-glass", id: "filterSubject", onchange: "this.form.submit()" %>
              <label for="filterSubject" class="text-white-50 small">Filtrar Disciplina</label>
            </div>
          </div>

          <div class="col-md-4">
            <div class="position-relative">
              <input type="text" name="search" 
                     class="form-control form-control-glass py-3" 
                     placeholder="Pesquisar tópicos..." 
                     value="<%= params[:search] %>"
                     style="padding-left: 15px !important;">
            </div>
          </div>

          <div class="col-md-2 d-flex">
            <button type="submit" class="btn btn-outline-purple-neon w-100">
              <i class="bi bi-search me-2"></i>Buscar
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# --- Cards de Bimestre com Filtro Ativo --- %>
  <div class="row align-items-center g-3 mb-5">
    <% @terms.each_with_index do |term, index| %>
      <% glow_class = ["border-glow-purple", "border-glow-blue", "border-glow-green", "border-glow-orange"][index] %>
      <% is_active = params[:term_id] == term.id.to_s %>
      <div class="col">
        <%= link_to lessons_path(classroom_id: params[:classroom_id], subject_id: params[:subject_id], term_id: (is_active ? nil : term.id)), class: "text-decoration-none" do %>
          <div class="glass-card text-center p-3 h-100 <%= glow_class %>" style="border-top: 3px solid <%= term.color %> !important; background: <%= is_active ? 'rgba(255,255,255,0.1)' : 'transparent' %>; transition: all 0.3s ease;">
            <span class="d-block label-neon-small mb-1" style="color: <%= term.color %>; font-size: 0.6rem; letter-spacing: 1px;">
              <%= term.name.upcase %> <%= "✓" if is_active %>
            </span>
            <div class="h3 fw-bold mb-0 text-white"><%= term.work_days %></div>
            <div class="text-white-50" style="font-size: 0.55rem; letter-spacing: 0.5px; text-transform: uppercase;">Dias Letivos</div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="col-auto">
      <button type="button" class="btn btn-outline-purple-neon d-flex align-items-center justify-content-center rounded-circle" 
              style="width: 45px; height: 45px; padding: 0;" 
              data-bs-toggle="modal" data-bs-target="#configBimestral">
        <i class="bi bi-gear-fill fs-5"></i>
      </button>
    </div>
  </div>

  <%# --- Dashboard de Resumo --- %>
  <div class="row g-3 mb-4 text-center">
    <div class="col-md-3">
      <div class="glass-card p-3 border-glow-blue h-100">
        <div class="label-neon-small mb-2" style="color: var(--neon-blue);">Total de Aulas</div>
        <div class="h2 mb-0 fw-bold text-white"><%= @total_lessons %></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card p-3 border-glow-green h-100">
        <div class="label-neon-small mb-2" style="color: var(--neon-green);">Aulas Prontas</div>
        <div class="h2 mb-0 fw-bold text-white"><%= @lessons_ready %></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card p-3 border-glow-orange h-100">
        <div class="label-neon-small mb-2" style="color: var(--neon-orange);">Em Andamento</div>
        <div class="h2 mb-0 fw-bold text-white"><%= @lessons_in_progress %></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card p-3 h-100" style="border-color: rgba(255,255,255,0.1);">
        <div class="label-neon-small mb-2 text-white-50">Não Iniciadas</div>
        <div class="h2 mb-0 fw-bold text-white-50"><%= @lessons_not_started %></div>
      </div>
    </div>
  </div>

  <%# --- Barra de Progresso --- %>
  <div class="glass-card p-4 mb-5 border-glow-green">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="label-neon-small">Percentual de Aulas Finalizadas</span>
      <span class="badge badge-neon-purple fs-6"><%= @progress_percentage %>%</span>
    </div>
    <div class="progress-neon" style="height: 12px;">
      <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: <%= @progress_percentage %>%; background-color: var(--neon-green);"></div>
    </div>
  </div>

  <%# --- BANCO DE AULAS LECIONADAS --- %>
  <div class="glass-card mb-5 overflow-hidden">
    <div class="card-header bg-transparent py-3 border-bottom border-secondary d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-bold text-white">Banco de Aulas Lecionadas</h5>
      <span class="badge badge-neon-purple opacity-75">Role para ver mais</span>
    </div>
    
    <div class="table-responsive-scroll">
      <table class="table table-dark-neon table-hover align-middle mb-0">
        <thead class="sticky-thead">
          <tr>
            <th class="ps-4">Nome da Aula</th>
            <th>Status Aula</th>
            <th>Data</th>
            <th>Turma</th>
            <th>Disciplina</th>
            <th class="text-end pe-4">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @lessons_list.each do |lesson| %>
            <tr>
              <td class="ps-4">
                <div class="d-flex flex-column gap-2">
                  <span class="fw-bold text-white"><%= lesson.topic_name %></span>
                  <div class="d-flex flex-wrap gap-2">
                    <% if lesson.has_activity %>
                      <span class="badge-status-neon badge-neon-blue">
                        <i class="bi bi-file-earmark-text"></i> Atividade Vinculada
                      </span>
                      <% act = lesson.activities.first %>
                      <% if act&.status == "corrigida" %>
                        <span class="badge-status-neon badge-neon-green">
                          <i class="bi bi-check-circle-fill"></i> Corrigida
                        </span>
                      <% else %>
                        <span class="badge-status-neon badge-neon-orange">
                          <i class="bi bi-hourglass-split"></i> Aguardando Correção
                        </span>
                      <% end %>
                    <% else %>
                      <span class="badge-status-neon badge-neon-red">
                        <i class="bi bi-x-circle"></i> Sem Atividade
                      </span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge <%= (lesson.status == 'pronto' || lesson.status == 'pronta') ? 'badge-neon-green' : 'badge-neon-purple' %> px-2 py-1">
                  <%= lesson.status&.humanize %>
                </span>
              </td>
              <td class="text-white-50 small"><%= lesson.date&.strftime("%d/%m/%Y") %></td>
              <td>
                <% if lesson.classrooms.any? %>
                  <% lesson.classrooms.each do |c| %>
                    <span class="badge border border-secondary text-white-50 d-block mb-1 text-start"><%= c.full_name_info %></span>
                  <% end %>
                <% elsif lesson.classroom_id.present? && (fallback_classroom = Classroom.find_by(id: lesson.classroom_id)) %>
                  <span class="badge border border-secondary text-white-50 d-block mb-1 text-start"><%= fallback_classroom.full_name_info %></span>
                <% else %>
                  <span class="badge border border-danger text-danger d-block mb-1">Sem Turma</span>
                <% end %>
              </td>
              <td>
                <% if lesson.subject %>
                  <span class="text-purple-neon small fw-bold"><%= lesson.subject&.name %></span>
                <% end %>
              </td>
              <td class="text-end pe-4">
                <div class="d-inline-flex gap-2">
                  <%= link_to edit_lesson_path(lesson), class: "text-white-50 hover-white" do %><i class="bi bi-pencil"></i><% end %>
                  <%= button_to lesson_path(lesson), method: :delete, class: "btn-link text-danger border-0 bg-transparent p-0", data: { turbo_confirm: "Excluir esta aula?" } do %><i class="bi bi-trash"></i><% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# --- FORMULÁRIO DE CADASTRO RÁPIDO --- %>
  <div class="glass-card border-glow-purple mb-5 p-4">
    <h5 class="fw-bold text-purple-neon mb-4">Novo Tópico de Aula</h5>

    <%= form_with(model: @lesson, local: true) do |f| %>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="label-neon-small mb-1">Título da Aula</label>
          <%= f.text_field :topic_name, class: "form-control form-control-glass", id: "main_topic_field", placeholder: "Ex: Classificação do Carbono" %>
        </div>
        <div class="col-md-2">
          <label class="label-neon-small mb-1">Turma(s)</label>
          <%= f.collection_select :classroom_ids, @available_classrooms, :id, :full_name_info, {}, { class: "form-select form-control-glass js-maestro-tom-select", id: "select-turmas", multiple: true, name: "lesson[classroom_ids][]" } %>
        </div>
        <div class="col-md-2">
          <label class="label-neon-small mb-1">Disciplina</label>
          <%= f.collection_select :subject_id, @available_subjects, :id, :name, { prompt: "Selecionar" }, { class: "form-select form-control-glass", id: "main_subject_select" } %>
        </div>
        <div class="col-md-2">
          <label class="label-neon-small mb-1">Dia da Aula</label>
          <%= f.date_field :date, class: "form-control form-control-glass", id: "main_date_field" %>
        </div>
        <div class="col-md-2">
          <label class="label-neon-small mb-1">Status</label>
          <%= f.select :status, Lesson.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "form-select form-control-glass" %>
        </div>
        <div class="col-md-1 text-center">
          <label class="label-neon-small mb-1">Atv?</label>
          <div class="form-check form-switch d-inline-block">
            <%= f.check_box :has_activity, class: "form-check-input js-main-toggle", role: "switch", id: "main_has_activity" %>
          </div>
        </div>

        <%# Quadro de Detalhes da Atividade %>
        <div id="main-activity-section" class="col-12 mt-3 glass-card p-4 d-none" style="border-left: 5px solid var(--purple-neon) !important;">
          <h6 class="text-purple-neon fw-bold mb-3 small text-uppercase">Detalhes da Atividade</h6>
          <%= f.fields_for :activities, (@lesson.activities.first || @lesson.activities.build) do |a| %>
            <div class="row g-3 align-items-end">
              <div class="col-md-6">
                <%= a.label :name, "Nome da Atividade", class: "label-neon-small mb-1" %>
                <%= a.text_field :name, class: "form-control form-control-glass", id: "main_act_name" %>
              </div>
              <div class="col-md-3">
                <%= a.label :activity_type, "Tipo", class: "label-neon-small mb-1" %>
                <%= a.select :activity_type, 
                    ["Avaliação", "Trabalho", "Visto", "Lista de Exercícios", "Redação", "Apresentação", "Relatório"], 
                    { prompt: "Tipo..." }, 
                    { class: "form-select form-control-glass", id: "main_act_type" } %>
              </div>
              <div class="col-md-3">
                <%= a.label :points, "Peso", class: "label-neon-small mb-1" %>
                <%= a.number_field :points, step: 0.1, class: "form-control form-control-glass", value: 10.0, id: "main_act_points" %>
              </div>
              <%= a.hidden_field :date, id: "main_act_date_hidden" %>
              <%= a.hidden_field :classroom_id, id: "main_act_classroom_hidden" %>
              <%= a.hidden_field :subject_id, id: "main_act_subject_hidden" %>
              <%= a.hidden_field :status, value: "pendente" %>
            </div>
          <% end %>
        </div>

        <div class="col-12 text-center mt-4">
          <%= f.submit "Cadastrar no Maestro", class: "btn btn-outline-purple-neon px-5 fw-bold" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# --- Calendário --- %>
  <div class="glass-card mb-5 overflow-hidden border-glow-purple">
    <% current_date = params[:start_date] ? params[:start_date].to_date : Date.today %>
    <div class="card-header bg-transparent py-3 border-bottom border-secondary d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-bold text-white d-flex align-items-center">
        <i class="bi bi-calendar3 me-2 text-purple-neon"></i>
        <span class="text-capitalize"><%= I18n.l(current_date, format: "%B %Y") %></span>
      </h5>
      <div class="btn-group shadow-sm ms-2">
        <%= link_to lessons_path(start_date: current_date - 1.month), class: "btn btn-outline-purple-neon btn-sm" do %><i class="bi bi-chevron-left"></i><% end %>
        <%= link_to "Hoje", lessons_path(start_date: Date.today), class: "btn btn-outline-purple-neon btn-sm fw-bold" %>
        <%= link_to lessons_path(start_date: current_date + 1.month), class: "btn btn-outline-purple-neon btn-sm" do %><i class="bi bi-chevron-right"></i><% end %>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="calendar-dark-theme">
        <%= month_calendar(events: @lessons_list, attribute: :date, header: { class: "d-none" }) do |date, lessons| %>
          <div class="calendar-day-inner">
            <div class="day-number-container">
              <span class="day-number <%= 'today-neon' if date == Date.today %>">
                <%= date.day %>
              </span>
            </div>
            <div class="lessons-wrapper">
              <% lessons.each do |lesson| %>
                <div class="badge-calendar-lesson" title="<%= lesson.topic_name %>">
                  <i class="bi bi-mortarboard-fill me-1" style="font-size: 0.6rem;"></i>
                  <%= lesson.topic_name %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# --- Modal de Configuração --- %>
<div class="modal fade" id="configBimestral" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content glass-card p-4">
      <h5 class="fw-bold text-purple-neon mb-4">Configuração dos Períodos Letivos</h5>
      <div class="row g-3">
        <% @terms.each do |term| %>
          <div class="col-md-6">
            <div class="p-3 border border-secondary rounded-3">
              <h6 class="fw-bold mb-3" style="color: <%= term.color %>"><%= term.name %></h6>
              <%= form_with(model: term, local: false) do |f| %>
                <div class="row g-2">
                  <div class="col-6">
                    <label class="label-neon-small">Início</label>
                    <%= f.date_field :start_date, class: "form-control form-control-glass form-control-sm" %>
                  </div>
                  <div class="col-6">
                    <label class="label-neon-small">Fim</label>
                    <%= f.date_field :end_date, class: "form-control form-control-glass form-control-sm" %>
                  </div>
                  <div class="col-12 mt-2 d-flex gap-2">
                    <%= f.color_field :color, class: "form-control form-control-color bg-transparent border-0", style: "width: 50px;" %>
                    <button type="submit" class="btn btn-sm btn-outline-purple-neon flex-grow-1">Salvar</button>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  .table-responsive-scroll {
    max-height: 450px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--purple-neon) transparent;
  }
  .table-responsive-scroll::-webkit-scrollbar { width: 6px; }
  .table-responsive-scroll::-webkit-scrollbar-thumb {
    background-color: var(--purple-neon);
    border-radius: 10px;
  }
  .sticky-thead {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: #121214 !important;
  }
  .calendar-container-fixed table { table-layout: fixed !important; width: 100% !important; border-collapse: collapse; }
  .calendar-day-cell { height: 100px; width: 100%; padding: 4px; border: 1px solid rgba(255,255,255,0.05); overflow: hidden; }
  .badge-calendar-lesson { background: var(--purple-neon); color: white; font-size: 0.55rem; padding: 2px 4px; border-radius: 4px; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hover-white:hover { color: white !important; }
</style>

<script>
  function setupMaestroLessonsUI() {
    const mainToggle = document.querySelector('.js-main-toggle');
    const mainSection = document.getElementById('main-activity-section');
    const topicInput = document.getElementById('main_topic_field');
    const nameInput = document.getElementById('main_act_name');
    const dateInput = document.getElementById('main_date_field');
    
    const classroomSelect = document.getElementById('select-turmas');
    const subjectSelect = document.getElementById('main_subject_select');
    
    const hiddenDate = document.getElementById('main_act_date_hidden');
    const hiddenClassroom = document.getElementById('main_act_classroom_hidden');
    const hiddenSubject = document.getElementById('main_act_subject_hidden');

    let tsInstance;
    if (classroomSelect) {
      if (classroomSelect.tomselect) {
        classroomSelect.tomselect.destroy();
      }
      
      tsInstance = new TomSelect(classroomSelect, {
        persist: false,
        create: false,
        maxItems: null,
        plugins: {
          'remove_button': {
            title: 'Remover turma',
          }
        },
        placeholder: "Selecione as turmas...",
        onDropdownOpen: function() {
          this.dropdown.classList.add('glass-card');
        }
      });
    }

    if (mainToggle && mainSection) {
      const syncHiddenFields = () => {
        if (hiddenDate && dateInput) hiddenDate.value = dateInput.value;
        if (hiddenClassroom && tsInstance) {
          hiddenClassroom.value = tsInstance.getValue().join(',');
        }
        if (hiddenSubject && subjectSelect) hiddenSubject.value = subjectSelect.value;
      };

      const toggleFn = () => {
        if (mainToggle.checked) {
          mainSection.classList.remove('d-none');
          mainSection.querySelectorAll('input:not([type="hidden"]), select').forEach(el => el.disabled = false);
          
          if (nameInput && (nameInput.value === "" || nameInput.value.startsWith("Atv:"))) {
            nameInput.value = "Atv: " + (topicInput.value || "");
          }
          syncHiddenFields();
        } else {
          mainSection.classList.add('d-none');
          mainSection.querySelectorAll('input:not([type="hidden"]), select').forEach(el => el.disabled = true);
        }
      };

      mainToggle.removeEventListener('change', toggleFn);
      mainToggle.addEventListener('change', toggleFn);

      [dateInput, subjectSelect].forEach(el => {
        el?.removeEventListener('change', syncHiddenFields);
        el?.addEventListener('change', syncHiddenFields);
      });

      if (tsInstance) {
        tsInstance.on('change', syncHiddenFields);
      }

      topicInput?.removeEventListener('input', () => {});
      topicInput?.addEventListener('input', () => {
        if (mainToggle.checked && nameInput?.value.startsWith("Atv:")) {
          nameInput.value = "Atv: " + topicInput.value;
        }
      });
      
      toggleFn();
    }
  }

  document.removeEventListener("turbo:load", setupMaestroLessonsUI);
  document.addEventListener("turbo:load", setupMaestroLessonsUI);
  
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMaestroLessonsUI);
  } else {
    setupMaestroLessonsUI();
  }
</script>