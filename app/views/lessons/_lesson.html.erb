<tr id="<%= dom_id lesson %>">
  <td class="px-4 fw-bold text-dark"><%= lesson.topic_name %></td>
  
  <td>
    <% 
      badge_class = case lesson.status
                    when "pronto" then "bg-success text-white"
                    when "preparando" then "bg-warning text-dark"
                    when "arquivado" then "bg-secondary text-white"
                    else "bg-light text-dark border"
                    end
    %>
    <span class="badge rounded-pill <%= badge_class %>" style="min-width: 80px;">
      <%= lesson.status.titleize %>
    </span>
  </td>

  <td><%= lesson.week %></td>
  
  <td><%= lesson.date&.strftime("%d/%m/%Y") %></td>

  <%# --- CORREÇÃO CIRÚRGICA: Suporte amigável a Múltiplas Turmas --- %>
  <td class="small text-muted">
    <% if lesson.classrooms.any? %>
      <% lesson.classrooms.each_with_index do |cls, index| %>
        <span class="fw-bold text-secondary"><%= cls.course&.name %></span> | 
        <%= cls.level&.name || cls.try(:grade)&.name %> - <%= cls.section&.name %>
        <%= ", " if index < lesson.classrooms.size - 1 %>
      <% end %>
    <% elsif lesson.classroom_id.present? %>
      <%# Fallback seguro para registros legados da coluna singular %>
      <% legacy_classroom = Classroom.find_by(id: lesson.classroom_id) %>
      <% if legacy_classroom %>
        <span class="fw-bold text-secondary"><%= legacy_classroom.course&.name %></span> | 
        <%= legacy_classroom.level&.name || legacy_classroom.try(:grade)&.name %> - <%= legacy_classroom.section&.name %>
      <% else %>
        <span class="text-danger">Não vinculada</span>
      <% end %>
    <% else %>
      <span class="text-danger">Não vinculada</span>
    <% end %>
  </td>

  <td class="text-center">
    <div class="d-flex justify-content-center gap-2">
      <%= link_to edit_lesson_path(lesson), class: "btn btn-sm btn-light text-primary shadow-sm", title: "Editar Tópico" do %>
        <i class="bi bi-pencil-square"></i>
      <% end %>

      <%= link_to lesson_path(lesson), 
                  data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir esta aula? Esta ação não pode ser desfeita." }, 
                  class: "btn btn-sm btn-light text-danger shadow-sm", 
                  title: "Excluir Tópico" do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
  </td>
</tr>