<%= turbo_frame_tag "modal" do %>

  <div class="modal-backdrop fade show"></div>

  <div class="modal d-block" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content border-0 rounded-4 shadow-lg">

        <div class="modal-header border-0 pb-2">
          <div>
            <h5 class="modal-title fw-bold mb-1">
              ✏️ Editar Aula
            </h5>
            <small class="text-muted">
              Atualize as informações do tópico selecionado
            </small>
          </div>

          <%= link_to lessons_path,
                class: "btn-close",
                data: { turbo_frame: "_top" } %>
        </div>

        <div class="modal-body pt-3">

          <%= form_with model: @lesson do |f| %>

            <div class="card border-0 shadow-sm mb-4 rounded-4">
              <div class="card-body">
                <h6 class="fw-bold text-uppercase small text-muted mb-3">
                  Informações Gerais
                </h6>

                <div class="row g-3">
                  <div class="col-md-4">
                    <%= f.label :status, "Status", class: "form-label small fw-bold text-muted text-uppercase" %>
                    <%= f.select :status,
                          [["🟢 Pronto", "pronto"],
                           ["🟡 Preparando", "preparando"],
                           ["⚪ Não Iniciada", "não_iniciada"]],
                          {},
                          class: "form-select shadow-sm" %>
                  </div>

                  <div class="col-md-8">
                    <%= f.label :topic_name, "Nome do Tópico",
                          class: "form-label small fw-bold text-muted text-uppercase" %>
                    <%= f.text_field :topic_name,
                          class: "form-control shadow-sm" %>
                  </div>

                  <div class="col-md-6">
                    <%= f.label :week, "Semana",
                          class: "form-label small fw-bold text-muted text-uppercase" %>
                    <%= f.number_field :week,
                          class: "form-control shadow-sm" %>
                  </div>

                  <div class="col-md-6">
                    <%= f.label :date, "Data",
                          class: "form-label small fw-bold text-muted text-uppercase" %>
                    <%= f.date_field :date,
                          class: "form-control shadow-sm" %>
                  </div>
                </div>
              </div>
            </div>

            <div class="card border-0 shadow-sm mb-4 rounded-4">
              <div class="card-body">
                <h6 class="fw-bold text-uppercase small text-muted mb-3">
                  Classificação Acadêmica
                </h6>

                <div class="row g-3">
                  <div class="col-md-12">
                    <%= f.label :classroom_id, "Vincular à Turma (Curso/Série/Turma)", 
                          class: "form-label small fw-bold text-muted text-uppercase" %>
                    <%= f.collection_select :classroom_id, 
                          Classroom.all.includes(:course, :grade, :section), :id, :full_name_info, 
                          { prompt: "Selecione a Turma..." }, 
                          { class: "form-select shadow-sm", required: true } %>
                    <div class="form-text small">Ao alterar a turma, o curso e a série serão atualizados automaticamente na tabela.</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
              <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                  <h6 class="fw-bold small text-uppercase text-muted mb-1">
                    Atividade
                  </h6>
                  <small class="text-muted">
                    Indique se esta aula possui atividade proposta
                  </small>
                </div>

                <div class="form-check form-switch">
                  <%= f.check_box :has_activity,
                        class: "form-check-input",
                        style: "width: 2.5em; height: 1.3em;" %>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-3 pt-3 border-top">
              <%= link_to "Cancelar",
                    lessons_path,
                    class: "btn btn-light px-4",
                    data: { turbo_frame: "_top" } %>

              <%= f.submit "Salvar Alterações",
                    class: "btn btn-primary px-5 fw-bold shadow-sm" %>
            </div>

          <% end %>

        </div>
      </div>
    </div>
  </div>

<% end %>