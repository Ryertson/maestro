<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: sans-serif; color: #333; line-height: 1.5; }
    .header { text-align: center; border-bottom: 2px solid #6f42c1; padding-bottom: 10px; margin-bottom: 30px; }
    h1 { color: #6f42c1; margin: 0; }
    table { width: 100%; border-collapse: collapse; }
    th { background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 10px; text-align: left; }
    td { border: 1px solid #dee2e6; padding: 8px; }
    .text-center { text-align: center; }
    .footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 10px; color: #999; }
  </style>
</head>
<body>
  <div class="header">
    <h1>MAESTRO - RELATÓRIO DE RECUPERAÇÃO</h1>
    <p>Turma: <%= @classroom.full_name_info %></p>
  </div>

  <%= yield %>

  <div class="footer">
    Gerado em <%= Time.current.strftime('%d/%m/%Y %H:%M') %>
  </div>
</body>
</html>