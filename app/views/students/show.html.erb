<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 100vh;">
  
  <%# --- CABEÇALHO --- %>
  <div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to "Turmas", classrooms_path, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item active"><%= @student.classroom&.display_name %></li>
        </ol>
      </nav>
      <h2 class="fw-bold text-dark d-flex align-items-center mb-0">
        <i class="bx bx-user-circle text-primary me-2"></i> <%= @student.name %>
      </h2>
      <p class="text-muted small mb-0">Relatório de desempenho oficial sincronizado com o mapa de notas.</p>
    </div>

    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-primary shadow-sm rounded-pill px-3 fw-bold btn-sm">
        <i class="bx bx-printer"></i> Imprimir Ficha
      </button>
      <%= link_to edit_student_path(@student), class: "btn btn-white border shadow-sm rounded-pill px-3 fw-bold btn-sm" do %>
        <i class="bx bx-edit-alt"></i> Editar
      <% end %>
      <%= link_to "Voltar", :back, class: "btn btn-light border shadow-sm rounded-pill px-3 fw-bold btn-sm" %>
    </div>
  </div>

  <div class="row g-4">
    <%# --- COLUNA ESQUERDA: CARDS DE RESUMO --- %>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 text-center">
          <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
            <i class="bx bx-user text-primary" style="font-size: 2.5rem;"></i>
          </div>
          <h5 class="fw-bold mb-1"><%= @student.name %></h5>
          <span class="badge bg-light text-dark border rounded-pill px-3 mb-3"><%= @student.classroom&.display_name %></span>
          
          <hr class="my-4 opacity-50">
          
          <div class="row g-2">
            <div class="col-6">
              <div class="p-3 border rounded-3 bg-light text-center">
                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.6rem;">Atividades</small>
                <span class="h4 fw-bold mb-0"><%= @student.student_activities.count %></span>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 border rounded-3 bg-primary bg-opacity-10 text-center border-primary border-opacity-25">
                <small class="text-primary d-block text-uppercase fw-bold" style="font-size: 0.6rem;">Média Final</small>
                <span class="h4 fw-bold text-primary mb-0"><%= @media_final %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# MONITOR DE FREQUÊNCIA - AJUSTADO PARA CENTRALIZAÇÃO PERFEITA %>
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-4">Frequência Geral</h6>
          <div class="position-relative mx-auto" style="height: 150px; width: 150px;">
            <canvas id="attendanceDonutChart"></canvas>
            <div class="chart-center-label">
               <span class="fw-bold text-dark" style="font-size: 1.2rem;"><%= @percentual_presenca %>%</span>
            </div>
          </div>
          <div class="d-flex justify-content-around mt-4">
            <div class="text-center">
              <small class="text-muted d-block">Presenças</small>
              <span class="fw-bold text-success"><%= @total_aulas - @faltas_count %></span>
            </div>
            <div class="text-center">
              <small class="text-muted d-block">Faltas</small>
              <span class="fw-bold text-danger"><%= @faltas_count %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# --- COLUNA DIREITA: TABELA AGRUPADA POR BIMESTRE --- %>
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-0 pt-4 ps-4">
          <h5 class="fw-bold mb-0">Desempenho por Período</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-light">
                <tr>
                  <th class="ps-4 py-3 small text-uppercase text-muted">Atividade</th>
                  <th class="small text-uppercase text-muted">Data</th>
                  <th class="text-center small text-uppercase text-muted">Status</th>
                  <th class="text-end pe-4 small text-uppercase text-muted">Nota</th>
                </tr>
              </thead>
              <tbody>
                <% if @activities_by_bimester.any? %>
                  <% @activities_by_bimester.each do |bimestre, activities| %>
                    <tr class="bg-light">
                      <td colspan="4" class="ps-4 py-2 border-start border-primary border-4" style="background-color: #f1f4f9;">
                        <span class="fw-bold text-primary text-uppercase" style="font-size: 0.7rem;">
                          <i class="bx bx-calendar-star me-1"></i> <%= bimestre %>
                        </span>
                      </td>
                    </tr>
                    <% activities.each do |activity| %>
                      <% submission = @submissions[activity.id] %>
                      <tr>
                        <td class="ps-4">
                          <span class="fw-bold text-dark"><%= activity.name %></span>
                          <div class="small text-muted"><%= activity.activity_type %></div>
                        </td>
                        <td class="small"><%= activity.date&.strftime("%d/%m/%Y") %></td>
                        <td class="text-center">
                          <% if submission %>
                            <% color = case submission.status when 'Entregue' then 'success' when 'Não Entregue' then 'danger' else 'warning' end %>
                            <span class="badge bg-<%= color %>-subtle text-<%= color %> border border-<%= color %>-subtle rounded-pill px-3">
                              <%= submission.status %>
                            </span>
                          <% else %>
                            <span class="badge bg-light text-muted border rounded-pill px-3">Pendente</span>
                          <% end %>
                        </td>
                        <td class="text-end pe-4 fw-bold text-primary">
                          <%= submission&.points || '--' %>
                        </td>
                      </tr>
                    <% end %>
                  <% end %>
                <% else %>
                  <tr><td colspan="4" class="text-center py-5 text-muted">Nenhuma atividade registrada.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function renderStudentChart() {
    const ctx = document.getElementById('attendanceDonutChart');
    if (!ctx) return;
    if (window.myStudentChart) { window.myStudentChart.destroy(); }
    window.myStudentChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Presença', 'Faltas'],
        datasets: [{
          data: [<%= @percentual_presenca %>, <%= @percentual_faltas %>],
          backgroundColor: ['#0d6efd', '#dc3545'],
          borderWidth: 0
        }]
      },
      options: { 
        cutout: '80%', 
        responsive: true, 
        maintainAspectRatio: false, 
        plugins: { legend: { display: false } } 
      }
    });
  }
  document.addEventListener("turbo:load", renderStudentChart);
  document.addEventListener("DOMContentLoaded", renderStudentChart);
</script>

<style>
  .rounded-4 { border-radius: 1rem !important; }
  
  /* ESTILO PARA CENTRALIZAR O TEXTO NO GRÁFICO */
  .chart-center-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  @media print {
    .btn, .breadcrumb, nav, .no-print { display: none !important; }
    .card { box-shadow: none !important; border: 1px solid #ddd !important; }
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  }
</style>