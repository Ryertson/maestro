<p style="color: green"><%= notice %></p>

<div class="container-fluid py-4">
  <%# --- CABEÇALHO --- %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-secondary mb-0">Gestão de Alunos e Frequência</h1>
      <p class="text-muted small">Dashboard de acompanhamento e diário de classe</p>
    </div>
    <% if current_professor.admin? %>
      <%= link_to '➕ Matricular Alunos', new_student_path, class: "btn btn-primary shadow-sm rounded-pill px-4" %>
    <% end %>
  </div>

  <%# --- DASHBOARD DE MÉTRICAS RÁPIDAS --- %>
  <div class="row g-3 mb-2">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-success border-5">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-success-subtle text-success rounded-3 p-2 me-3">
            <i class="bi bi-check-all fs-4"></i>
          </div>
          <div>
            <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.7rem;">Presenças</small>
            <h4 id="total-presents-card" class="fw-bold mb-0 text-dark"><%= @total_presents || 0 %></h4>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-danger border-5">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-danger-subtle text-danger rounded-3 p-2 me-3">
            <i class="bi bi-x-circle fs-4"></i>
          </div>
          <div>
            <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.7rem;">Faltas</small>
            <h4 id="total-absents-card" class="fw-bold mb-0 text-dark"><%= @total_absents || 0 %></h4>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-warning border-5">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-warning-subtle text-warning rounded-3 p-2 me-3">
            <i class="bi bi-clock-history fs-4"></i>
          </div>
          <div>
            <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.7rem;">Atrasos</small>
            <h4 id="total-lates-card" class="fw-bold mb-0 text-dark"><%= @total_lates || 0 %></h4>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-info border-5">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-info-subtle text-info rounded-3 p-2 me-3">
            <i class="bi bi-info-circle fs-4"></i>
          </div>
          <div>
            <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.7rem;">Justificadas</small>
            <h4 id="total-justified-card" class="fw-bold mb-0 text-dark"><%= @total_justified || 0 %></h4>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# --- BARRA DE APROVEITAMENTO --- %>
  <div class="px-2 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <small class="text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Aproveitamento (Presença Real)</small>
      <small id="attendance-rate-text" class="fw-bold text-primary"><%= @attendance_rate || 0 %>%</small>
    </div>
    <div class="progress rounded-pill shadow-sm" style="height: 8px; background-color: #e9ecef;">
      <div id="attendance-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
           role="progressbar" 
           style="width: <%= @attendance_rate || 0 %>%" 
           aria-valuenow="<%= @attendance_rate %>" aria-valuemin="0" aria-valuemax="100">
      </div>
    </div>
  </div>

  <%# --- FILTROS --- %>
  <div class="card mb-4 border-0 shadow-sm bg-dark text-white rounded-4">
    <div class="card-body p-4">
      <%= form_with url: request.path, method: :get, local: true, class: "row g-3 align-items-end" do |f| %>
        <div class="col-md-3">
          <%= f.label :month_year, "Mês/Ano", class: "form-label small opacity-75 fw-bold" %>
          <%= f.month_field :month_year, value: params[:month_year] || @selected_date.strftime("%Y-%m"), class: "form-control bg-secondary text-white border-0 shadow-sm", onchange: "this.form.submit()" %>
        </div>
        <div class="col-md-4">
          <%= f.label :classroom_id, "Turma", class: "form-label small opacity-75 fw-bold" %>
          <%= f.collection_select :classroom_id, (@available_classrooms || Classroom.all), :id, :full_name_info, 
              { include_blank: "Escolha a Turma...", selected: @classroom_id }, 
              { class: "form-select bg-secondary text-white border-0 shadow-sm", onchange: "this.form.submit()" } %>
        </div>
        <div class="col-md-3">
          <%= f.label :student_id, "Aluno Específico", class: "form-label small opacity-75 fw-bold" %>
          <%= f.collection_select :student_id, (@students || []), :id, :name, 
              { include_blank: "Todos os Alunos", selected: params[:student_id] }, 
              { class: "form-select bg-secondary text-white border-0 shadow-sm", onchange: "this.form.submit()" } %>
        </div>
        <div class="col-md-2">
           <%= f.submit "Filtrar", class: "btn btn-info w-100 fw-bold rounded-3 text-white shadow-sm", style: "background-color: #00cae3; border: none; height: 38px;" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# --- LEGENDA --- %>
  <div class="d-flex justify-content-end align-items-center gap-4 mb-3 px-3 py-2 bg-white rounded-4 shadow-sm border border-light">
    <small class="text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Legenda:</small>
    <div class="d-flex align-items-center gap-2">
      <span class="badge rounded-circle p-0 d-flex align-items-center justify-content-center" style="background-color: #198754; width: 18px; height: 18px;"><i class="bi bi-check-lg text-white" style="font-size: 10px;"></i></span>
      <small class="fw-bold text-secondary" style="font-size: 11px;">Presença</small>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge rounded-circle p-0 d-flex align-items-center justify-content-center" style="background-color: #dc3545; width: 18px; height: 18px;"><i class="bi bi-x text-white" style="font-size: 10px;"></i></span>
      <small class="fw-bold text-secondary" style="font-size: 11px;">Falta</small>
    </div>
    <div class="d-flex align-items-center gap-2 pe-3 border-end text-nowrap">
      <span class="badge rounded-1 border border-secondary border-opacity-25" style="background-color: #2b2b40; width: 16px; height: 16px;"></span>
      <small class="fw-bold text-muted" style="font-size: 11px;">Vazio / Sem Aula</small>
    </div>
  </div>

  <%# --- PLANILHA --- %>
  <div class="card border-0 shadow-sm overflow-hidden rounded-4" style="background-color: #1e1e2d;">
    <div class="table-responsive">
      <table class="table table-sm table-bordered border-secondary mb-0 text-center align-middle" style="color: #a2a3b7;">
        <thead>
          <% inicio_mes = @start_of_month; fim_mes = @end_of_month %>
          <tr>
            <th rowspan="3" class="bg-dark text-white align-middle border-secondary px-3" style="min-width: 240px;">ESTUDANTE</th>
            <% (inicio_mes..fim_mes).group_by { |d| d.strftime("%U") }.each_with_index do |(week, days), index| %>
              <th colspan="<%= days.count %>" class="py-2 small fw-bold text-uppercase text-white" 
                  style="background-color: <%= ['#004d40', '#1b5e20', '#4a148c', '#e65100', '#263238'][index % 5] %>;">
                Semana <%= index + 1 %>
              </th>
            <% end %>
            <th rowspan="3" class="bg-danger text-white align-middle border-secondary fw-bold" style="min-width: 50px;">F</th>
          </tr>
          <tr style="background-color: #1b1b28;">
            <% (inicio_mes..fim_mes).each do |day| %>
              <th class="p-0 border-secondary" style="height: 40px; min-width: 28px;">
                <div class="vertical-text text-uppercase fw-bold" style="font-size: 9px;"><%= I18n.l(day, format: "%a").delete('.') %></div>
              </th>
            <% end %>
          </tr>
          <tr style="background-color: #1b1b28;">
            <% (inicio_mes..fim_mes).each do |day| %>
              <th class="small py-1 border-secondary <%= 'bg-secondary bg-opacity-25 text-white' if day.saturday? || day.sunday? %>">
                <%= day.day %>
              </th>
            <% end %>
          </tr>
        </thead>

        <tbody>
          <% if @students.present? && @students.any? %>
            <% @students.each do |student| %>
              <tr>
                <td class="text-start ps-3 fw-bold text-white small border-secondary" style="background-color: #1b1b28;">
                  <%# Atualizado: Link do estudante também forçando HTML e sem Turbo %>
                  <%= link_to student.name.upcase.truncate(30), student_path(student, format: :html), data: { turbo: false }, class: "text-decoration-none text-white" %>
                </td>

                <% (inicio_mes..fim_mes).each do |day| %>
                  <% is_weekend = day.saturday? || day.sunday?; has_lesson = @planned_dates.include?(day) %>
                  <td class="p-1 border-secondary <%= 'bg-secondary bg-opacity-10' if is_weekend %>">
                    <% att = student.attendances.detect { |a| a.date == day } %>
                    <% status_slug = case att&.status&.to_s&.downcase&.strip
                                    when 'presente', 'present' then 'present'
                                    when 'faltou', 'absent' then 'absent'
                                    when 'atrasado', 'late' then 'late'
                                    when 'justificada', 'justified' then 'justified'
                                    else ''
                                    end %>
                    
                    <div class="dropdown">
                      <button id="btn-<%= student.id %>-<%= day %>" 
                              class="btn btn-sm p-0 w-100 h-100 attendance-box border-secondary border p-<%= status_slug %> <%= 'opacity-25' unless has_lesson %>" 
                              type="button" data-bs-toggle="dropdown" aria-expanded="false" 
                              style="min-height: 25px; min-width: 25px;" autocomplete="off">
                        <% if att %>
                          <i class="bi <%= attendance_icon(status_slug) %> small text-white"></i>
                        <% elsif !has_lesson && !is_weekend %>
                          <span style="font-size: 7px; color: #444;">OFF</span>
                        <% end %>
                      </button>
                      
                      <ul class="dropdown-menu shadow-lg border-0 bg-dark p-2" style="z-index: 9999;">
                        <% if has_lesson %>
                          <% ['present', 'absent', 'late', 'justified', 'clear'].each do |status| %>
                            <li>
                              <%# --- ATUALIZAÇÃO CRÍTICA: Forçado format: :html, local: true e data: { turbo: false } --- %>
                              <%= form_with url: student_attendances_path(student, format: :html), method: :post, local: true, data: { turbo: false } do |f| %>
                                <%= hidden_field_tag :date, day %>
                                <%= hidden_field_tag :status, status %>
                                <%= hidden_field_tag :classroom_id, student.classroom_id %>
                                <% lesson_id = @lessons_in_month.find { |l| l.date == day }&.id %>
                                <%= hidden_field_tag :lesson_id, lesson_id %>
                                
                                <% if status == 'clear' %>
                                  <hr class="dropdown-divider border-secondary">
                                  <button type="submit" class="dropdown-item text-white-50"><i class="bi bi-trash3 me-2"></i>Limpar Registro</button>
                                <% else %>
                                  <button type="submit" class="dropdown-item text-<%= status == 'present' ? 'success' : (status == 'absent' ? 'danger' : (status == 'late' ? 'warning' : 'info')) %> py-2 fw-bold">
                                    <i class="bi <%= attendance_icon(status) %> me-2"></i><%= status.humanize %>
                                  </button>
                                <% end %>
                              <% end %>
                            </li>
                          <% end %>
                        <% else %>
                          <li class="p-3 text-center">
                            <i class="bi bi-calendar-x text-warning d-block mb-2 fs-4"></i>
                            <small class="text-white opacity-75">Nenhuma aula planejada.</small>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                  </td>
                <% end %>

                <td id="total-faltas-<%= student.id %>" class="fw-bold border-secondary" style="background-color: #2c0b0e; color: #ff6b6b;">
                  <%= student.attendances.where(date: inicio_mes..fim_mes, status: ['absent', 'Faltou']).count %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="50" class="p-5 text-muted bg-dark text-center py-5">Selecione uma turma.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .table-responsive { overflow: visible !important; padding-bottom: 100px; }
  .vertical-text { writing-mode: vertical-lr; transform: rotate(180deg); display: inline-block; margin: 0 auto; color: #6c7293; }
  .attendance-box { background-color: #2b2b40; transition: all 0.2s ease; border-radius: 4px; }
  .attendance-box:hover { background-color: #3f4254; border-color: #00cae3 !important; transform: scale(1.1); }
  .dropdown-menu { border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.5) !important; background-color: #1e1e2d !important; min-width: 180px; }
  .dropdown-item { font-size: 13px; color: inherit; transition: 0.2s; cursor: pointer; }
  .p-present { background-color: #198754 !important; }
  .p-absent { background-color: #dc3545 !important; }
  .p-late { background-color: #ffc107 !important; color: #000 !important; }
  .p-justified { background-color: #0dcaf0 !important; }
</style>