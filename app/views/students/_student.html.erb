<div id="<%= dom_id student %>">
  <div>
    <strong>Name:</strong>
    <%= student.name %>
  </div>

  <div>
    <strong>Registration number:</strong>
    <%= student.registration_number %>
  </div>

  <div>
    <strong>Grade:</strong>
    <%= student.grade %>
  </div>

  <div>
    <strong>Classroom:</strong>
    <%= student.classroom %>
  </div>

  <div>
    <strong>Course:</strong>
    <%= student.course %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= student.email %>
  </div>

  <div>
    <strong>Active:</strong>
    <%= student.active %>
  </div>

</div>
