<%= form_with(model: topic) do |form| %>
  <% if topic.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(topic.errors.count, "error") %> prohibited this topic from being saved:</h2>

      <ul>
        <% topic.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div class="mb-3">
    <%= form.label :schedule, "Horário", class: "form-label" %>
    <%= form.select :schedule, [
    ["1º horário - 07:30", 1], ["2º horário - 08:20", 2], ["3º horário - 09:30", 3],
    ["4º horário - 10:20", 4], ["5º horário - 11:10", 5], ["6º horário - 13:20", 6],
    ["7º horário - 14:10", 7], ["8º horário - 15:20", 8], ["9º horário - 16:10", 9]
    ], { prompt: "Selecione o horário" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :day_of_week, "Dia da Semana", class: "form-label" %>
    <%= form.select :day_of_week, [
    ["Segunda-feira", 1], ["Terça-feira", 2], ["Quarta-feira", 3],
    ["Quinta-feira", 4], ["Sexta-feira", 5]
    ], { prompt: "Selecione o dia" }, { class: "form-select" } %>
  </div>

  <div>
    <%= form.label :subject_name, style: "display: block" %>
    <%= form.text_field :subject_name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
