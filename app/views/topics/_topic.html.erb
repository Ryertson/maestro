<div id="<%= dom_id topic %>">
  <div>
    <strong>Title:</strong>
    <%= topic.title %>
  </div>

  <div>
    <strong>Schedule:</strong>
    <%= topic.schedule %>
  </div>

  <div>
    <strong>Day of week:</strong>
    <%= topic.day_of_week %>
  </div>

  <div>
    <strong>Subject name:</strong>
    <%= topic.subject_name %>
  </div>

</div>
