<%# Painel de Controle - Visível apenas no Navegador (não sai na impressão) %>
<div class="no-print" style="padding: 20px; background-color: #1a1a2e; border-bottom: 2px solid #6f42c1; text-align: center; font-family: sans-serif;">
  <h4 style="color: white; margin-bottom: 15px; font-size: 16px;">Visualização do Relatório</h4>
  <button onclick="window.print();" style="padding: 12px 25px; background-color: #6f42c1; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 14px; box-shadow: 0 4px 15px rgba(111, 66, 193, 0.4); transition: 0.3s;">
    <i class="bi bi-download"></i> BAIXAR / IMPRIMIR RELATÓRIO
  </button>
  <p style="color: #a2a3b7; font-size: 11px; margin-top: 12px;">
    <strong>Dica:</strong> O download deve abrir automaticamente. Caso contrário, clique no botão acima e selecione <b>"Salvar como PDF"</b>.
  </p>
</div>

<%# Conteúdo do Relatório %>
<div class="pdf-container" style="padding: 40px; background-color: white;">
  <div class="pdf-header" style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #6f42c1; padding-bottom: 10px;">
    <h1 style="color: #6f42c1; margin-bottom: 5px;">Relatório de Alunos em Recuperação</h1>
    <h2 style="color: #333; font-size: 18px;">Turma: <%= @classroom.full_name_info %></h2>
    <p style="color: #666; font-size: 12px;">Data de Emissão: <%= Date.today.strftime('%d/%m/%Y') %></p>
  </div>

  <table class="pdf-table" style="width: 100%; border-collapse: collapse; margin-top: 20px; font-family: sans-serif;">
    <thead>
      <tr style="background-color: #f8f9fa;">
        <th style="border: 1px solid #dee2e6; padding: 12px; text-align: left; color: #6f42c1;">Estudante</th>
        <th style="border: 1px solid #dee2e6; padding: 12px; text-align: center; color: #6f42c1;">Nota da Prova</th>
        <th style="border: 1px solid #dee2e6; padding: 12px; text-align: center; color: #6f42c1;">Situação</th>
      </tr>
    </thead>
    <tbody>
      <%# Definimos os IDs das atividades uma única vez fora do loop para ganhar performance %>
      <% activity_ids = @classroom.activities.pluck(:id) %>
      <% @classroom.students.order(:name).each do |student| %>
        <% n_prova = student.nota_da_prova(activity_ids) %>
        
        <% if n_prova < 6.0 %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 10px; border: 1px solid #dee2e6; font-weight: bold;"><%= student.name.upcase %></td>
            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center;"><%= number_with_precision(n_prova, precision: 1) %></td>
            <td style="padding: 10px; border: 1px solid #dee2e6; text-align: center; color: #dc3545; font-weight: bold;">RECUPERAÇÃO</td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

  <div class="pdf-footer" style="margin-top: 50px; text-align: center; font-size: 10px; color: #aaa; border-top: 1px solid #eee; padding-top: 10px;">
    <p>Maestro - Assistente Pedagógico IA | Este documento é para fins informativos e pedagógicos.</p>
  </div>
</div>

<%# Estilos para controle de impressão %>
<style>
  @media print {
    .no-print { display: none !important; }
    body { 
      background-color: white !important; 
      margin: 0; 
      padding: 0; 
    }
    .pdf-container {
      padding: 0 !important;
      box-shadow: none !important;
      margin: 0 !important;
      width: 100% !important;
    }
    tr { page-break-inside: avoid; }
  }

  body { 
    background-color: #0f0f1a; 
    margin: 0; 
  }
  
  .pdf-container {
    max-width: 800px;
    margin: 20px auto;
    box-shadow: 0 0 30px rgba(0,0,0,0.5);
    min-height: 29.7cm;
  }
</style>

<%# Script para Download Automático %>
<script>
  window.onload = function() {
    // Pequeno atraso de 800ms para garantir que o layout renderizou 100% antes de salvar
    setTimeout(function() {
      window.print();
    }, 800);
  };
</script>