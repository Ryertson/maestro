<div class="container-fluid px-4 py-4">
  <%# --- 1. CABEÇALHO MAESTRO --- %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold text-white mb-0">
        <i class="bi bi-grid-3x3-gap me-2 text-purple-neon"></i>Mapa de Pontuação
      </h1>
      <p class="text-white-50 small mb-0">Gestão de pontos por atividade e aproveitamento total (Média por Categorias)</p>
    </div>
    
    <div class="d-flex gap-2">
      <div class="dropdown" data-turbo="false">
        <button class="btn btn-outline-purple-neon dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-person-video3 me-2"></i>
          <%= @current_classroom&.full_name_info || "Selecionar Turma" %>
        </button>
        <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-secondary">
          <% @classrooms.each do |c| %>
            <li>
              <%= link_to c.full_name_info, student_points_path(classroom_id: c.id), 
                  class: "dropdown-item fw-bold #{'active bg-purple-neon' if c.id == @current_classroom&.id}",
                  data: { turbo: false } %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <% if @current_classroom %>
    <%# --- 2. MAPA DE PONTOS (GLASSMORPHISM) --- %>
    <div class="glass-card border-glow-blue overflow-hidden">
      <div class="table-responsive-scroll" style="max-height: 75vh;">
        <table class="table table-dark-neon table-hover align-middle mb-0">
          <thead class="sticky-thead">
            <tr class="text-center">
              <th class="ps-4 text-start sticky-column-dark border-end border-secondary" style="min-width: 280px; z-index: 11;">
                <span class="label-neon-small">Estudante</span>
              </th>
              
              <% @activities.each do |activity| %>
                <th class="text-center border-end border-secondary" style="min-width: 140px; background: rgba(255,255,255,0.02);">
                  <div class="badge-status-neon badge-neon-purple mb-1" style="font-size: 0.6rem;">
                    <%= activity.activity_type %>
                  </div>
                  <div class="text-truncate d-block small fw-bold text-white" title="<%= activity.name %>">
                    <%= activity.name %>
                  </div>
                  <div class="text-white-50 fw-normal" style="font-size: 0.65rem;">
                    <%= activity.date&.strftime("%d/%m") %> | <span class="text-purple-neon">Max: <%= activity.points %></span>
                  </div>
                </th>
              <% end %>

              <th class="text-center col-media-final text-white fw-bold shadow-sm" style="min-width: 120px;">
                MÉDIA FINAL
              </th>
            </tr>
          </thead>
          
          <tbody>
            <% @students.each do |student| %>
              <tr>
                <td class="ps-4 fw-bold sticky-column-dark border-end border-secondary shadow-sm">
                  <div class="d-flex align-items-center">
                    <div class="avatar-circle-dark me-3"><%= student.name[0] %></div>
                    <span class="text-white small text-uppercase"><%= student.name %></span>
                  </div>
                </td>
                
                <% @activities.each do |activity| %>
                  <%# SUBSTITUIÇÃO REALIZADA: Busca direta no banco de dados para evitar inconsistência de cache %>
                  <% score_record = student.student_points.find_by(activity_id: activity.id) %>
                  <% current_val = score_record&.points || 0 %>

                  <td class="text-center p-2 border-end border-secondary">
                    <input type="text" 
                           value="<%= score_record&.points %>" 
                           class="form-control form-control-glass text-center js-point-input mx-auto"
                           data-student="<%= student.id %>"
                           data-activity="<%= activity.id %>"
                           placeholder="0.0"
                           style="width: 70px; font-weight: 700; color: <%= current_val > 0 ? 'var(--neon-blue)' : 'white' %>; <%= 'opacity: 0.5;' if current_val == 0 %>">
                  </td>
                <% end %>
                
                <td class="text-center col-media-final border-start border-secondary shadow-sm">
                  <% media_atual = student.calcular_nota_com_pesos(@activities.map(&:id)) %>
                  <span class="js-total-<%= student.id %> media-final-badge <%= media_atual >= 6.0 ? 'media-alta' : 'media-baixa' %>">
                    <%= number_with_precision(media_atual, precision: 1) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="glass-card p-5 text-center border-glow-purple">
      <i class="bi bi-info-circle-fill text-purple-neon h1 d-block mb-3"></i>
      <h5 class="text-white fw-bold">Nenhuma turma selecionada</h5>
      <p class="text-white-50 mb-0">Selecione uma turma no menu superior para carregar o Mapa de Pontos.</p>
    </div>
  <% end %>
</div>

<style>
  .sticky-column-dark { 
    position: sticky; 
    left: 0; 
    z-index: 5; 
    background-color: #121214 !important; 
    box-shadow: 5px 0 15px rgba(0,0,0,0.3);
  }

  .avatar-circle-dark { 
    width: 32px; 
    height: 32px; 
    background-color: rgba(188, 19, 254, 0.1); 
    color: var(--purple-neon); 
    border: 1px solid var(--purple-neon);
    border-radius: 50%; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    font-size: 0.75rem; 
    font-weight: bold;
    text-shadow: 0 0 5px var(--purple-glow);
  }

  .save-success { border-color: var(--neon-green) !important; box-shadow: 0 0 10px var(--neon-green-glow) !important; }
  .save-error { border-color: var(--danger-neon) !important; box-shadow: 0 0 10px rgba(255, 49, 49, 0.3) !important; }
  
  .media-final-badge {
    font-weight: 800;
    font-size: 1.1rem;
    transition: all 0.3s ease;
  }
  .media-alta { color: var(--neon-green); text-shadow: 0 0 10px var(--neon-green-glow); }
  .media-baixa { color: var(--danger-neon); text-shadow: 0 0 10px rgba(255, 49, 49, 0.3); }

  .col-media-final {
    background: rgba(36, 182, 255, 0.05) !important;
    border-left: 1px solid var(--neon-blue) !important;
  }

  .update-pulse { animation: pulse-neon 0.8s; }
  @keyframes pulse-neon {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  document.addEventListener('turbo:load', function() {
    const inputs = document.querySelectorAll('.js-point-input');

    inputs.forEach(input => {
      input.addEventListener('blur', function() {
        const studentId = this.dataset.student;
        const activityId = this.dataset.activity;
        let points = this.value.replace(',', '.');

        if (points === "") points = 0;
        this.style.opacity = '0.5';

        fetch('/update_student_points', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
          },
          body: JSON.stringify({ student_id: studentId, activity_id: activityId, points: points })
        })
        .then(response => response.json())
        .then(data => {
          this.style.opacity = '1';
          if(data.status === 'success') {
            this.classList.add('save-success');
            this.classList.remove('save-error');
            this.value = data.points;
            
            const totalSpan = document.querySelector(`.js-total-${studentId}`);
            if(totalSpan && data.nova_media !== undefined) {
              const novaMedia = parseFloat(data.nova_media);
              totalSpan.innerText = novaMedia.toFixed(1);
              
              if (novaMedia >= 6.0) {
                totalSpan.className = `js-total-${studentId} media-final-badge media-alta update-pulse`;
              } else {
                totalSpan.className = `js-total-${studentId} media-final-badge media-baixa update-pulse`;
              }
              
              setTimeout(() => totalSpan.classList.remove('update-pulse'), 800);
            }

            setTimeout(() => this.classList.remove('save-success'), 1500);
          } else {
            this.classList.add('save-error');
            alert("Erro ao salvar: " + data.message);
          }
        })
        .catch(error => {
          this.style.opacity = '1';
          this.classList.add('save-error');
          console.error('Error:', error);
        });
      });
    });
  });
</script>